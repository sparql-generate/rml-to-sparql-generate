# The triples maps of the mapping, with their reference formulation ?rf, their
# base IRI ?tmbase, and ?group: the source shared with other triples maps
# (rewriting R3 of README.md: one iteration for them all,
# templates/csvGroup.rqg), or "" when the triples map is translated alone (templates/triplesMap.rqg).
#
# A triples map is grouped when its source is a CSV file (not a database, no
# rml:null values), read by at least one other such triples map, and when it has a reference (the shared iteration binds
# the union of the columns) and no blank node map without expression (whose
# blank node is one per iteration and per triples map).
PREFIX rr:   <http://www.w3.org/ns/r2rml#>
PREFIX rml:  <http://semweb.mmlab.be/ns/rml#>
PREFIX rmlc: <http://w3id.org/rml/>

SELECT <iterators/tms.rqg>(?base) ?tm ?rf ?tmbase ?group
WHERE {
  # a triples map without logical source (RML-FNML: constant term maps only)
  # is translated without iteration: ?rf is "NONE"
  ?tm (rr:subjectMap|rmlc:subjectMap|rr:subject|rmlc:subject) ?anySubject .
  OPTIONAL { ?tm (rml:logicalSource|rmlc:logicalSource)/(rml:referenceFormulation|rmlc:referenceFormulation) ?rfi }
  FILTER(BOUND(?rfi) || EXISTS { ?tm rmlc:logicalSource/rmlc:viewOn ?anyv0 }
         || NOT EXISTS { ?tm (rml:logicalSource|rmlc:logicalSource|rr:logicalTable) ?anyls })
  # a logical view (RML-LV): its iterations are rows, its keys columns
  # (templates/viewIteration.rqg)
  BIND(IF(EXISTS { ?tm rmlc:logicalSource/rmlc:viewOn ?anyv }, "CSV",
          COALESCE(REPLACE(STR(?rfi), "^.*[#/]", ""), "NONE")) AS ?rf)
  FILTER(?rf IN ("CSV", "JSONPath", "XPath", "NONE"))
  # a subject map that is a gather map: the triples map is translated by
  # templates/gather.rqg
  FILTER NOT EXISTS { ?tm rmlc:subjectMap/rmlc:gather ?anyg }
  # RML-star: the triples of a non-asserted triples map are only quoted
  FILTER NOT EXISTS { ?tm a rmlc:NonAssertedTriplesMap }
  OPTIONAL { ?tm rmlc:baseIRI ?b }
  BIND(COALESCE(STR(?b), ?base) AS ?tmbase)
  OPTIONAL {
    # the shared sources first (evaluated once), then the candidate triples
    # maps, joined by ?src: in the other order, the engine evaluates the
    # sources again for every candidate (a time in the square of the number
    # of triples maps)
    { SELECT ?src WHERE {
        ?tm2 (rml:logicalSource|rmlc:logicalSource) ?ls2 .
        ?ls2 (rml:referenceFormulation|rmlc:referenceFormulation) ?rf2 .
        FILTER(REPLACE(STR(?rf2), "^.*[#/]", "") = "CSV")
        FILTER NOT EXISTS { ?ls2 <urn:x-rml2sg:sql> true }
        FILTER NOT EXISTS { ?ls2 rmlc:source/rmlc:null ?anyNull2 }
        OPTIONAL { ?ls2 (rml:source|rmlc:source) ?s2 FILTER(isLiteral(?s2)) }
        OPTIONAL { ?ls2 (rml:source|rmlc:source)/(rmlc:path|rmlc:file) ?p2 }
        BIND(STR(COALESCE(?p2, ?s2)) AS ?src)
        FILTER EXISTS {
          { ?tm2 (rr:subjectMap|rmlc:subjectMap) ?t2 }
          UNION { ?tm2 (rr:predicateObjectMap|rmlc:predicateObjectMap)/(rr:predicateMap|rmlc:predicateMap|rr:objectMap|rmlc:objectMap) ?t2 }
          ?t2 (rr:template|rmlc:template|rml:reference|rmlc:reference|rr:column) ?anon3 }
        FILTER NOT EXISTS {
          { ?tm2 (rr:subjectMap|rmlc:subjectMap) ?u2 }
          UNION { ?tm2 (rr:predicateObjectMap|rmlc:predicateObjectMap)/(rr:objectMap|rmlc:objectMap) ?u2 }
          ?u2 (rr:termType|rmlc:termType) ?tt2 . FILTER(?tt2 IN (rr:BlankNode, rmlc:BlankNode))
          FILTER NOT EXISTS { ?u2 (rr:template|rmlc:template|rml:reference|rmlc:reference|rr:constant|rmlc:constant) ?anon4 } }
        FILTER NOT EXISTS { ?tm2 (rmlc:subjectMap|rmlc:predicateObjectMap/rmlc:objectMap)/rmlc:joinCondition ?anon6 }
      } GROUP BY ?src HAVING (COUNT(DISTINCT ?tm2) > 1) }
    { SELECT ?tm ?src WHERE {
        ?tm (rml:logicalSource|rmlc:logicalSource) ?ls .
        ?ls (rml:referenceFormulation|rmlc:referenceFormulation) ?rf1 .
        FILTER(REPLACE(STR(?rf1), "^.*[#/]", "") = "CSV")
        # a relational database: one query per triples map (iter:SQL)
        FILTER NOT EXISTS { ?ls <urn:x-rml2sg:sql> true }
        # null values (RML-IO, rml:null) of its own: not shared with another
        # reading of the file
        FILTER NOT EXISTS { ?ls rmlc:source/rmlc:null ?anyNull }
        OPTIONAL { ?ls (rml:source|rmlc:source) ?s0 FILTER(isLiteral(?s0)) }
        OPTIONAL { ?ls (rml:source|rmlc:source)/(rmlc:path|rmlc:file) ?p0 }
        BIND(STR(COALESCE(?p0, ?s0)) AS ?src)
        FILTER EXISTS {
          { ?tm (rr:subjectMap|rmlc:subjectMap) ?t }
          UNION { ?tm (rr:predicateObjectMap|rmlc:predicateObjectMap)/(rr:predicateMap|rmlc:predicateMap|rr:objectMap|rmlc:objectMap) ?t }
          ?t (rr:template|rmlc:template|rml:reference|rmlc:reference|rr:column) ?anon1 }
        FILTER NOT EXISTS {
          { ?tm (rr:subjectMap|rmlc:subjectMap) ?u }
          UNION { ?tm (rr:predicateObjectMap|rmlc:predicateObjectMap)/(rr:objectMap|rmlc:objectMap) ?u }
          ?u (rr:termType|rmlc:termType) ?tt . FILTER(?tt IN (rr:BlankNode, rmlc:BlankNode))
          FILTER NOT EXISTS { ?u (rr:template|rmlc:template|rml:reference|rmlc:reference|rr:constant|rmlc:constant) ?anon2 } }
        # star maps with a join (RML-star): translated alone (templates/starJoins.rqg)
        FILTER NOT EXISTS { ?tm (rmlc:subjectMap|rmlc:predicateObjectMap/rmlc:objectMap)/rmlc:joinCondition ?anon5 }
      } }
  }
  BIND(COALESCE(?src, "") AS ?group)
}
ORDER BY ?tm
