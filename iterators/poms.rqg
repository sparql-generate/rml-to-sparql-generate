# The predicate-object maps of a triples map ?tm translated within its
# iteration (templates/triplesMap.rqg): one solution per (predicate-object
# map, predicate map, object map) whose triples go to the default graph, with
# ?key, a name for the variables of that pair, stable across calls (the
# generated triples and the generated BIND clauses must agree), and ?pbiri,
# the base IRI of the parent of a referencing object map ("" if none).
PREFIX rr:   <http://www.w3.org/ns/r2rml#>
PREFIX rml:  <http://semweb.mmlab.be/ns/rml#>
PREFIX rmlc: <http://w3id.org/rml/>
PREFIX afn:  <http://jena.apache.org/ARQ/function#>

SELECT <iterators/poms.rqg>(?tm) DISTINCT ?key ?st ?sc ?pt ?pc ?ot ?oc ?okind ?pbiri
WHERE {
    OPTIONAL { ?tm (rr:subjectMap|rmlc:subjectMap) ?sm0 }
    OPTIONAL { ?tm (rr:subject|rmlc:subject) ?sc0 }
    BIND(COALESCE(?sm0, <urn:x-rml2sg:none>) AS ?st)
    BIND(COALESCE(?sc0, <urn:x-rml2sg:none>) AS ?sc)
    ?tm (rr:predicateObjectMap|rmlc:predicateObjectMap) ?pom .
    { ?pom (rr:predicateMap|rmlc:predicateMap) ?pm0 } UNION { ?pom (rr:predicate|rmlc:predicate) ?pc0 }
    { ?pom (rr:objectMap|rmlc:objectMap) ?om0 } UNION { ?pom (rr:object|rmlc:object) ?oc0 }
    BIND(COALESCE(?pm0, <urn:x-rml2sg:none>) AS ?pt)
    BIND(COALESCE(?pc0, <urn:x-rml2sg:none>) AS ?pc)
    BIND(COALESCE(?oc0, <urn:x-rml2sg:none>) AS ?oc)
    # (an OPTIONAL on an unbound variable would match any node: ?omx is
    # always bound, and the OPTIONALs are nested)
    BIND(COALESCE(?om0, <urn:x-rml2sg:none>) AS ?omx)
    OPTIONAL { ?omx (rr:parentTriplesMap|rmlc:parentTriplesMap) ?ptm .
               OPTIONAL { ?ptm (rr:subjectMap|rmlc:subjectMap) ?psm } }
    # a referencing object map is translated here only without join, on the
    # same logical source: the object is then the parent's subject, on the
    # same iteration
    FILTER(!BOUND(?ptm) || (
      NOT EXISTS { ?omx (rr:joinCondition|rmlc:joinCondition) ?anon3 } && EXISTS {
        ?tm (rml:logicalSource|rmlc:logicalSource) ?ls1 .
        ?ptm (rml:logicalSource|rmlc:logicalSource) ?ls2 .
        FILTER(?ls1 = ?ls2 || EXISTS {
          # effectively equal logical sources: same source, reference
          # formulation and iterator
          ?ls1 (rml:referenceFormulation|rmlc:referenceFormulation) ?rfa .
          ?ls2 (rml:referenceFormulation|rmlc:referenceFormulation) ?rfa .
          OPTIONAL { ?ls1 (rml:source|rmlc:source) ?sa FILTER(isLiteral(?sa)) }
          OPTIONAL { ?ls1 (rml:source|rmlc:source)/(rmlc:path|rmlc:file) ?pa }
          OPTIONAL { ?ls2 (rml:source|rmlc:source) ?sb FILTER(isLiteral(?sb)) }
          OPTIONAL { ?ls2 (rml:source|rmlc:source)/(rmlc:path|rmlc:file) ?pb }
          OPTIONAL { ?ls1 (rml:iterator|rmlc:iterator) ?ia }
          OPTIONAL { ?ls2 (rml:iterator|rmlc:iterator) ?ib }
          FILTER(STR(COALESCE(?pa, ?sa, "")) = STR(COALESCE(?pb, ?sb, ""))
                 && STR(COALESCE(?ia, "")) = STR(COALESCE(?ib, "")))
        })
      }))
    BIND(IF(BOUND(?ptm), ?psm, COALESCE(?om0, <urn:x-rml2sg:none>)) AS ?ot)
    BIND(IF(BOUND(?ptm), "subject", "object") AS ?okind)
    # the parent's own base IRI (rml:baseIRI), or "": its subject is built
    # against it, not against the child's
    BIND(COALESCE(?ptm, <urn:x-rml2sg:none>) AS ?ptmx)
    OPTIONAL { ?ptmx rmlc:baseIRI ?pb0 }
    BIND(COALESCE(STR(?pb0), "") AS ?pbiri)
    # the triples go to the default graph
    FILTER(NOT EXISTS { { ?st (rr:graphMap|rmlc:graphMap|rr:graph|rmlc:graph) ?g1 } UNION { ?pom (rr:graphMap|rmlc:graphMap|rr:graph|rmlc:graph) ?g2 } }
        || EXISTS { { ?st ((rr:graphMap|rmlc:graphMap)/(rr:constant|rmlc:constant)|rr:graph|rmlc:graph) ?dg }
                    UNION { ?pom ((rr:graphMap|rmlc:graphMap)/(rr:constant|rmlc:constant)|rr:graph|rmlc:graph) ?dg }
                    FILTER(?dg IN (rr:defaultGraph, rmlc:defaultGraph)) })
    BIND(CONCAT(IF(isBlank(?pom), afn:bnode(?pom), STR(?pom)), "|",
                IF(isBlank(?pt), afn:bnode(?pt), STR(?pt)), "|", STR(?pc), "|",
                IF(isBlank(?ot), afn:bnode(?ot), STR(?ot)), "|", STR(?oc)) AS ?id)
    BIND(MD5(?id) AS ?key)
}
ORDER BY ?key
