# The distinct references of the triples maps of group ?src (see
# iterators/tms.rqg), in a fixed order: the CSV column list of the shared
# iteration and the list of its variables are generated by two calls, which
# must agree (R3 of τ', templates/csvGroup.rqg).
SELECT <iterators/groupReferences.rqg>(?src, ?base) DISTINCT ?ref
ITERATOR <iterators/tms.rqg>(?base) AS ?tm ?rf ?tmbase ?group
ITERATOR <iterators/references.rqg>("tm", ?tm, <urn:x-rml2sg:none>, <urn:x-rml2sg:none>) AS ?ref
WHERE { FILTER(?group = ?src) }
ORDER BY ?ref
