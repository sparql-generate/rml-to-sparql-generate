# The references used by the term maps of one scope (iterators/pieces.rqg)
# that are reached from one node ?x of the mapping, in role ?role: "tm" (a
# triples map), "pom" (a predicate-object map) or "om" (a referencing object
# map), as ONE string in RML template syntax (templates verbatim, each
# reference r as "{r}", with \, { and } escaped).
#
# Every branch starts from ?x, the only parameter it reads: the engine (Jena)
# then substitutes the value of ?x into the pattern, which follows the
# mapping from that node only. With several parameters, each read by some
# branches only, the pattern is evaluated over the whole mapping and joined
# with the parameters afterwards, a time in the size of the mapping for every
# call (gtfs-feeds, 1 300 triples maps).
PREFIX rr:   <http://www.w3.org/ns/r2rml#>
PREFIX rml:  <http://semweb.mmlab.be/ns/rml#>
PREFIX rmlc: <http://w3id.org/rml/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT <iterators/piecesOf.rqg>(?scope, ?role, ?x)
       (GROUP_CONCAT(?piece; separator="") AS ?all)
WHERE {
  {
    # term maps
    {
      {
        BIND("term" AS ?scope0) BIND("tm" AS ?role0)
        ?x (rmlc:functionExecution/rmlc:input/rmlc:inputValueMap|rmlc:condition)*/(rr:template|rmlc:template|rml:reference|rmlc:reference|rr:column) ?anyValue .
        BIND(?x AS ?t)
      } UNION {
        BIND("tm" AS ?scope0) BIND("tm" AS ?role0)
        { ?x (rr:subjectMap|rmlc:subjectMap) ?t }
        UNION { ?x (rr:subjectMap|rmlc:subjectMap)/(rr:graphMap|rmlc:graphMap) ?t }
        UNION { ?x (rr:predicateObjectMap|rmlc:predicateObjectMap)/(rr:predicateMap|rmlc:predicateMap|rr:objectMap|rmlc:objectMap|rr:graphMap|rmlc:graphMap) ?t }
        UNION { ?x (rr:predicateObjectMap|rmlc:predicateObjectMap)/(rr:objectMap|rmlc:objectMap)/(rmlc:languageMap|rmlc:datatypeMap) ?t }
        # the term maps of the triples maps quoted by star maps (RML-star), on
        # the same iteration (without join), the child keys of the others
        UNION { ?x ((rr:subjectMap|rmlc:subjectMap)|(rr:predicateObjectMap|rmlc:predicateObjectMap)/(rr:objectMap|rmlc:objectMap)) ?sx0 .
                FILTER NOT EXISTS { ?sx0 rmlc:joinCondition ?anon6 }
                ?sx0 (rmlc:quotedTriplesMap/(rmlc:subjectMap|rmlc:predicateObjectMap/(rmlc:predicateMap|rmlc:objectMap)))+ ?t }
        UNION { ?x ((rr:subjectMap|rmlc:subjectMap)|(rr:predicateObjectMap|rmlc:predicateObjectMap)/(rr:objectMap|rmlc:objectMap)) ?sjx .
                ?sjx rmlc:quotedTriplesMap ?anon7 ; rmlc:joinCondition/rmlc:childMap ?t }
        # the members of gather maps (RML-CC), nested ones included
        UNION { ?x ((rr:subjectMap|rmlc:subjectMap)|(rr:predicateObjectMap|rmlc:predicateObjectMap)/(rr:objectMap|rmlc:objectMap))/(rmlc:gather/rdf:rest*/rdf:first)+ ?t }
        # their referencing object maps: the parent's subject (no join), the child keys
        UNION { ?x ((rr:subjectMap|rmlc:subjectMap)|(rr:predicateObjectMap|rmlc:predicateObjectMap)/(rr:objectMap|rmlc:objectMap))/(rmlc:gather/rdf:rest*/rdf:first)+ ?grom .
                ?grom rmlc:parentTriplesMap/rmlc:subjectMap ?t .
                FILTER NOT EXISTS { ?grom rmlc:joinCondition ?anon5 } }
        UNION { ?x ((rr:subjectMap|rmlc:subjectMap)|(rr:predicateObjectMap|rmlc:predicateObjectMap)/(rr:objectMap|rmlc:objectMap))/(rmlc:gather/rdf:rest*/rdf:first)+/rmlc:joinCondition/rmlc:childMap ?t }
        UNION {
          ?x (rr:predicateObjectMap|rmlc:predicateObjectMap)/(rr:objectMap|rmlc:objectMap) ?rom .
          ?rom (rr:parentTriplesMap|rmlc:parentTriplesMap) ?ptm .
          FILTER NOT EXISTS { ?rom (rr:joinCondition|rmlc:joinCondition) ?anon1 }
          ?x (rml:logicalSource|rmlc:logicalSource) ?ls1 .
          ?ptm (rml:logicalSource|rmlc:logicalSource) ?ls2 .
          FILTER(?ls1 = ?ls2 || EXISTS {
          # effectively equal logical sources: same source, reference
          # formulation and iterator
          ?ls1 (rml:referenceFormulation|rmlc:referenceFormulation) ?rfa .
          ?ls2 (rml:referenceFormulation|rmlc:referenceFormulation) ?rfa .
          OPTIONAL { ?ls1 (rml:source|rmlc:source) ?sa FILTER(isLiteral(?sa)) }
          OPTIONAL { ?ls1 (rml:source|rmlc:source)/(rmlc:path|rmlc:file) ?pa }
          OPTIONAL { ?ls2 (rml:source|rmlc:source) ?sb FILTER(isLiteral(?sb)) }
          OPTIONAL { ?ls2 (rml:source|rmlc:source)/(rmlc:path|rmlc:file) ?pb }
          OPTIONAL { ?ls1 (rml:iterator|rmlc:iterator) ?ia }
          OPTIONAL { ?ls2 (rml:iterator|rmlc:iterator) ?ib }
          FILTER(STR(COALESCE(?pa, ?sa, "")) = STR(COALESCE(?pb, ?sb, ""))
                 && STR(COALESCE(?ia, "")) = STR(COALESCE(?ib, "")))
        })
          ?ptm (rr:subjectMap|rmlc:subjectMap) ?t
        }
        UNION {
          # a join made on the same row (rewriting R8): the parent's subject
          ?x (rr:predicateObjectMap|rmlc:predicateObjectMap)/(rr:objectMap|rmlc:objectMap) ?srom .
          ?srom <urn:x-rml2sg:sameRow> true ; (rr:parentTriplesMap|rmlc:parentTriplesMap)/(rr:subjectMap|rmlc:subjectMap) ?t
        }
        UNION {
          # a blank node subject without expression: its joins are made in its
          # iteration (templates/joinInIteration.rqg), which reads the child keys
          ?x (rr:predicateObjectMap|rmlc:predicateObjectMap)/(rr:objectMap|rmlc:objectMap)/(rr:joinCondition|rmlc:joinCondition)/rmlc:childMap ?t .
          FILTER(EXISTS { ?x (rr:subjectMap|rmlc:subjectMap) ?bs .
                         ?bs (rr:termType|rmlc:termType) ?btt . FILTER(?btt IN (rr:BlankNode, rmlc:BlankNode))
                         FILTER NOT EXISTS { ?bs (rr:template|rmlc:template|rml:reference|rmlc:reference|rr:column|rr:constant|rmlc:constant) ?bx } })
        }
      } UNION {
        BIND("child" AS ?scope0)
        { BIND("tm" AS ?role0) ?x (rr:subjectMap|rmlc:subjectMap) ?t }
        UNION { BIND("tm" AS ?role0) ?x (rr:subjectMap|rmlc:subjectMap)/(rr:graphMap|rmlc:graphMap) ?t }
        UNION { BIND("pom" AS ?role0) ?x (rr:predicateMap|rmlc:predicateMap|rr:graphMap|rmlc:graphMap) ?t }
        UNION { BIND("om" AS ?role0) ?x (rr:joinCondition|rmlc:joinCondition)/rmlc:childMap ?t }
      } UNION {
        BIND("parent" AS ?scope0) BIND("om" AS ?role0)
        { ?x (rr:parentTriplesMap|rmlc:parentTriplesMap)/(rr:subjectMap|rmlc:subjectMap) ?t }
        UNION { ?x (rr:joinCondition|rmlc:joinCondition)/rmlc:parentMap ?t }
        # a star map with a join (RML-star): the term maps of its quoted triples map
        UNION { ?x rmlc:quotedTriplesMap/((rmlc:subjectMap|rmlc:predicateObjectMap/(rmlc:predicateMap|rmlc:objectMap))/rmlc:quotedTriplesMap)*/(rmlc:subjectMap|rmlc:predicateObjectMap/(rmlc:predicateMap|rmlc:objectMap)) ?t }
      }
    }
    # the term map, and the input value maps of its functions and conditions
    # (RML-FNML), nested ones included
    ?t (rmlc:functionExecution/rmlc:input/rmlc:inputValueMap|rmlc:condition)* ?t2 .
    OPTIONAL { ?t2 (rr:template|rmlc:template) ?tpl }
    OPTIONAL { ?t2 (rml:reference|rmlc:reference|rr:column) ?r }
  } UNION {
    # references given as strings: rr:child, rr:parent
    {
      BIND("child" AS ?scope0) BIND("om" AS ?role0)
      ?x (rr:joinCondition|rmlc:joinCondition)/(rr:child|rmlc:child) ?r
    } UNION {
      BIND("tm" AS ?scope0) BIND("tm" AS ?role0)
      ?x (rr:predicateObjectMap|rmlc:predicateObjectMap)/(rr:objectMap|rmlc:objectMap)/(rr:joinCondition|rmlc:joinCondition)/(rr:child|rmlc:child) ?r .
      FILTER(EXISTS { ?x (rr:subjectMap|rmlc:subjectMap) ?bs .
                         ?bs (rr:termType|rmlc:termType) ?btt . FILTER(?btt IN (rr:BlankNode, rmlc:BlankNode))
                         FILTER NOT EXISTS { ?bs (rr:template|rmlc:template|rml:reference|rmlc:reference|rr:column|rr:constant|rmlc:constant) ?bx } })
    } UNION {
      BIND("parent" AS ?scope0) BIND("om" AS ?role0)
      ?x (rr:joinCondition|rmlc:joinCondition)/(rr:parent|rmlc:parent) ?r
    } UNION {
      BIND("tm" AS ?scope0) BIND("tm" AS ?role0)
      ?x ((rr:subjectMap|rmlc:subjectMap)|(rr:predicateObjectMap|rmlc:predicateObjectMap)/(rr:objectMap|rmlc:objectMap))/(rmlc:gather/rdf:rest*/rdf:first)+/rmlc:joinCondition/rmlc:child ?r
    } UNION {
      BIND("tm" AS ?scope0) BIND("tm" AS ?role0)
      ?x ((rr:subjectMap|rmlc:subjectMap)|(rr:predicateObjectMap|rmlc:predicateObjectMap)/(rr:objectMap|rmlc:objectMap)) ?sjr .
      ?sjr rmlc:quotedTriplesMap ?anon8 ; rmlc:joinCondition/rmlc:child ?r
    }
  } UNION {
    # one empty piece: a call has a solution even when ?x reaches no term
    # map (the engine drops a call without solution); ?x is matched by a
    # path of length zero, which holds for any term
    ?x <urn:x-rml2sg:none>? ?x .
    BIND("" AS ?tpl)
  }
  BIND(COALESCE(STR(?tpl), CONCAT("\{", REPLACE(STR(?r), "([\\\\\{}])", "\\\\$1"), "}")) AS ?piece0)
  # the pieces of the scope and role asked for, and the empty piece
  BIND(IF(!BOUND(?scope0) || (?scope0 = ?scope && ?role0 = ?role), ?piece0, "") AS ?piece)
  FILTER(BOUND(?piece))
}
