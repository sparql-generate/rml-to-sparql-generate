# The references used by a set of term maps, as ONE string in RML template
# syntax: templates verbatim, each reference r as "{r}" (with \, { and }
# escaped). iterators/references.rqg splits it.
#
#   ?scope = "tm"      every term map of triples map ?tm, and the subject maps
#                      of the parents referenced without join condition (they
#                      are evaluated on the same iteration); for a blank node
#                      subject without expression, also the child keys of its
#                      joins (made in its iteration);
#   ?scope = "child"   the child side of the join ?om of predicate-object map
#                      ?pom: subject map, predicate maps, graph maps, child keys;
#   ?scope = "parent"  the parent side: parent subject map, parent keys;
#   ?scope = "term"    the single term map ?tm.
#
# The union of the pieces reached from each parameter (iterators/piecesOf.rqg:
# ?tm as a triples map or a term map, ?pom, ?om), one call per parameter, so
# that each call follows the mapping from its node only.

SELECT <iterators/pieces.rqg>(?scope, ?tm, ?pom, ?om) (CONCAT(?a, ?b, ?c) AS ?all)
ITERATOR <iterators/piecesOf.rqg>(?scope, "tm", ?tm) AS ?a
ITERATOR <iterators/piecesOf.rqg>(?scope, "pom", ?pom) AS ?b
ITERATOR <iterators/piecesOf.rqg>(?scope, "om", ?om) AS ?c
WHERE { }
