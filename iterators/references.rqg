# The distinct references of a set of term maps (see iterators/pieces.rqg),
# in a fixed order: the CSV column list and the list of its variables are
# generated by two calls, which must agree.
PREFIX iter: <http://w3id.org/sparql-generate/iter/>

SELECT <iterators/references.rqg>(?scope, ?tm, ?pom, ?om) DISTINCT ?ref
ITERATOR <iterators/pieces.rqg>(?scope, ?tm, ?pom, ?om) AS ?all
# one match per template segment: group 2 is "{reference}", or "" at the end
# (a closing brace is written } and not \}: the engine mis-reads "\\}")
ITERATOR iter:regex(?all, "((?:[^\{}\\\\]|\\\\.)*)(\\\{(?:[^\{}\\\\]|\\\\.)*}|$)", 2) AS ?g
WHERE {
  FILTER(STRLEN(?g) > 0)
  BIND(REPLACE(SUBSTR(?g, 2, STRLEN(?g) - 2), "\\\\(.)", "$1") AS ?ref)
}
ORDER BY ?ref
