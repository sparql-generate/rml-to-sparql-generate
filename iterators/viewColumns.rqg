# The columns of a CSV source that the fields of logical view ?view read
# (iterators/viewPieces.rqg), in a fixed order: the column list of iter:CSV and
# the list of its variables are generated by two calls, which must agree
# (templates/viewIteration.rqg).
PREFIX iter: <http://w3id.org/sparql-generate/iter/>

SELECT <iterators/viewColumns.rqg>(?view) DISTINCT ?col
ITERATOR <iterators/viewPieces.rqg>(?view) AS ?all
ITERATOR iter:regex(?all, "((?:[^\{}\\\\]|\\\\.)*)(\\\{(?:[^\{}\\\\]|\\\\.)*}|$)", 2) AS ?g
WHERE {
  FILTER(STRLEN(?g) > 0)
  BIND(REPLACE(SUBSTR(?g, 2, STRLEN(?g) - 2), "\\\\(.)", "$1") AS ?col)
}
ORDER BY ?col
