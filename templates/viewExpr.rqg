# The value of expression map ?t over the keys of a logical view (RML-LV: the
# fields of a join, its join conditions), as an expression: a reference r is the
# variable ?<P><md5(r)> of key r (templates/viewIteration.rqg), a template its
# text (templates/viewText.rqg), a constant its term.
PREFIX rmlc: <http://w3id.org/rml/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

TEMPLATE <templates/viewExpr.rqg>(?t, ?ref, ?P) {
  TEMPLATE { "?" ?P MD5(?r) } WHERE { FILTER(BOUND(?r)) } .
  TEMPLATE <templates/viewText.rqg>(?tpl, ?P) WHERE { FILTER(!BOUND(?r) && BOUND(?tpl)) } .
  TEMPLATE { ?constText } WHERE { FILTER(!BOUND(?r) && !BOUND(?tpl) && BOUND(?c)) } .
  TEMPLATE { "?none" } WHERE { FILTER(!BOUND(?r) && !BOUND(?tpl) && !BOUND(?c)) } .
}
WHERE {
  OPTIONAL { ?t rmlc:reference ?r0 }
  BIND(COALESCE(STR(?r0), IF(?ref != "", ?ref, ?none)) AS ?r)
  OPTIONAL { ?t rmlc:template ?tpl0 }
  BIND(STR(?tpl0) AS ?tpl)
  OPTIONAL { ?t rmlc:constant ?c }
  BIND(IF(isIRI(?c), CONCAT("<", STR(?c), ">"),
       CONCAT("\"", REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(STR(?c), "\\\\", "\\\\\\\\"), "\"", "\\\\\""), "\n", "\\\\n"), "\r", "\\\\r"), "\\\{", "\\\\\{"), "\"",
              IF(LANG(?c) != "", CONCAT("@", LANG(?c)),
              IF(DATATYPE(?c) != xsd:string, CONCAT("^^<", STR(DATATYPE(?c)), ">"), ""))))
       AS ?constText)
}
