# The value of the input of function execution ?fe whose parameter
# (rml:parameter, or rml:parameterMap with a constant) has the local name
# ?pname, as an expression (templates/function.rqg): a constant
# (rml:inputValue), the value of a term map (rml:inputValueMap,
# templates/valueExpr.rqg), or ?none when the function execution has no such
# input. The parameters of GREL are also known by the names of their
# predicates (grel:valueParameter for grel:valueParam, ...).
PREFIX rmlc: <http://w3id.org/rml/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

TEMPLATE <templates/functionArg.rqg>(?fe, ?pname, ?role, ?rf, ?dialect, ?base) {
  TEMPLATE { ?constText } WHERE { FILTER(BOUND(?iv)) } .
  TEMPLATE <templates/valueExpr.rqg>(?ivm, ?role, ?rf, ?dialect, ?base) WHERE { FILTER(BOUND(?ivm) && !BOUND(?iv)) } .
  TEMPLATE { "?none" } WHERE { FILTER(!BOUND(?iv) && !BOUND(?ivm)) } .
}
WHERE {
  BIND(IF(?pname = "valueParam", "valueParameter", IF(?pname = "valueParam2", "valueParameter2",
       IF(?pname = "param_find", "p_string_find", IF(?pname = "param_replace", "p_string_replace",
       IF(?pname = "modeParam", "modeParameter", ?pname))))) AS ?alias)
  OPTIONAL {
    ?fe rmlc:input ?in .
    ?in (rmlc:parameter|rmlc:parameterMap/rmlc:constant) ?param .
    FILTER(REPLACE(STR(?param), "^.*[#/]", "") IN (?pname, ?alias))
    OPTIONAL { ?in rmlc:inputValue ?iv }
    OPTIONAL { ?in rmlc:inputValueMap ?ivm }
  }
  BIND(IF(isIRI(?iv), CONCAT("<", STR(?iv), ">"),
       CONCAT("\"", REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(STR(?iv), "\\\\", "\\\\\\\\"), "\"", "\\\\\""), "\n", "\\\\n"), "\r", "\\\\r"), "\\\{", "\\\\\{"), "\"",
              IF(LANG(?iv) != "", CONCAT("@", LANG(?iv)),
              IF(DATATYPE(?iv) != xsd:string, CONCAT("^^<", STR(DATATYPE(?iv)), ">"), ""))))
       AS ?constText)
}
