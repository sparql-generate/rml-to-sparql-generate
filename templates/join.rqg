# The translation of a referencing object map ?om of predicate-object map ?pom of triples
# map ?tm, with a join condition or over another logical source than its
# parent. One sub-query at the top level of the generated query: both sides
# are first generated as a graph, then joined by a basic graph pattern.
#
#   GENERATE { ?s ?p ?o . }
#   FROM GENERATE {
#     GENERATE { ?o <urn:x-rml2sg:parent_h> ?q_h . } <parent iteration> WHERE { ... } .
#     GENERATE { ?s <urn:x-rml2sg:child_h> ?k_h . }  <child iteration>  WHERE { ... } .
#   } .
#   WHERE { ?s <urn:x-rml2sg:child_h> ?x . ?o <urn:x-rml2sg:parent_h> ?x . BIND(<p> AS ?p) }
#
# A graph is a set: a child subject with the same key in many iterations is
# one triple, so the join costs the size of its result, not the product of
# the iterations that share a key (shapes and their points in GTFS). With a
# predicate that depends on the child iteration, each iteration is a node
# (_:c, _:r) with its subject, predicate and key. Several join conditions
# make one composite key (iterators/joinKeys.rqg, templates/compositeKey.rqg:
# <urn:x-rml2sg:child_keys>, <urn:x-rml2sg:parent_keys>), looked up at once:
# with a key triple per condition, the join of one condition after the other
# costs every pair of a child and a parent with the same value of the first
# condition (a feed identifier), the others tested afterwards. A missing key value generates
# no key triple, hence no join; keys are compared as strings
# (iterators/joinConditions.rqg names each condition).
# Iterating over the parent for each child iteration would give the same
# set of triples, at the cost of the product of the two sources.
#
# Graph maps (templates/graphs.rqg): the triple goes to the graphs of the
# child's subject map and predicate-object map. A graph map with an expression
# is evaluated in the child's iteration: each iteration is then a node ?cn,
# with the graph term(s) of that iteration, <urn:x-rml2sg:graph_<h>> ?g_<h>
# (CSV: bound in the child's WHERE clause; JSONPath, XPath: a sub-query, one
# value per solution); the join reads them with OPTIONAL, and a graph without
# value generates no quad.
PREFIX rr:   <http://www.w3.org/ns/r2rml#>
PREFIX rml:  <http://semweb.mmlab.be/ns/rml#>
PREFIX rmlc: <http://w3id.org/rml/>

TEMPLATE <templates/join.rqg>(?tm, ?pom, ?pt, ?pc, ?om, ?rf, ?prf, ?dialect, ?base, ?pbase) {
  "\n  # " ?tmText " → " ?ptmText "\n"
  "  GENERATE \{ "
  TEMPLATE <templates/graphs.rqg>(?st, ?pom, ?pt, ?om, "?s ?p ?o .", "var", "", ?rf, ?dialect, ?base) .
  "}\n"
  "  FROM GENERATE \{\n"

  # the parent side
  "    GENERATE \{"
  TEMPLATE { " " ?pnode " <urn:x-rml2sg:parent_" ?h "> ?q" ?h " ." }
  ITERATOR <iterators/joinKeys.rqg>(?om) AS ?h .
  TEMPLATE { " _:r <urn:x-rml2sg:subject> ?o ." } WHERE { FILTER(?records) } .
  TEMPLATE { " ?o <urn:x-rml2sg:parent> true ." } WHERE { FILTER(!?keys) } .
  " }\n      "
  TEMPLATE <templates/iteration.rqg>(?ptm, "parent", ?pom, ?om, ?prf) .
  "\n      "
  TEMPLATE <templates/referenceIterators.rqg>(?psm, "", "o", ?prf, ?dialect) .
  TEMPLATE { TEMPLATE <templates/referenceIterators.rqg>(?jt, ?jr, CONCAT("q", ?h), ?prf, ?dialect) . }
  ITERATOR <iterators/joinConditions.rqg>(?om) AS ?h ?ct ?cr ?jt ?jr .
  "WHERE \{ "
  TEMPLATE <templates/termMap.rqg>(?psm, <urn:x-rml2sg:none>, "", "o", "subject", ?prf, ?dialect, ?pbase) .
  TEMPLATE { TEMPLATE <templates/termMap.rqg>(?jt, <urn:x-rml2sg:none>, ?jr, CONCAT("q", ?h), "key", ?prf, ?dialect, ?pbase) . }
  ITERATOR <iterators/joinConditions.rqg>(?om) AS ?h ?ct ?cr ?jt ?jr .
  TEMPLATE <templates/compositeKey.rqg>(?om, "q") .
  "} .\n"

  # the child side: a graph of its keys, or (rewriting R9) its iteration
  # read as a stream, each row looking up the parent keys
  TEMPLATE {
    "    GENERATE \{"
    TEMPLATE { " " ?cnode " <urn:x-rml2sg:child_" ?h "> ?k" ?h " ." }
    ITERATOR <iterators/joinKeys.rqg>(?om) AS ?h .
    TEMPLATE { " " ?cnode " <urn:x-rml2sg:subject> ?s ; <urn:x-rml2sg:predicate> ?p ." } WHERE { FILTER(?records) } .
    TEMPLATE { " ?s <urn:x-rml2sg:child> true ." } WHERE { FILTER(!?keys) } .
    # the graph terms of the iteration
    TEMPLATE { " ?cn <urn:x-rml2sg:graph_" ?h "> ?g_" ?h " ." }
    ITERATOR <iterators/graphMaps.rqg>(?tm, ?pom) AS ?h ?gt
    WHERE { FILTER(?rf = "CSV") } .
    TEMPLATE {
      " GENERATE \{ ?cn <urn:x-rml2sg:graph_" ?h "> ?g . } "
      TEMPLATE <templates/referenceIterators.rqg>(?gt, "", "g", ?rf, ?dialect) .
      "WHERE \{ "
      TEMPLATE <templates/termMap.rqg>(?gt, <urn:x-rml2sg:none>, "", "g", "graph", ?rf, ?dialect, ?base) .
      "} ."
    }
    ITERATOR <iterators/graphMaps.rqg>(?tm, ?pom) AS ?h ?gt
    WHERE { FILTER(?rf != "CSV") } .
    " }\n      "
    TEMPLATE <templates/iteration.rqg>(?tm, "child", ?pom, ?om, ?rf) .
    "\n      "
    TEMPLATE <templates/referenceIterators.rqg>(?st, "", "s", ?rf, ?dialect) .
    TEMPLATE <templates/referenceIterators.rqg>(?pt, "", "p", ?rf, ?dialect) WHERE { FILTER(?records) } .
    TEMPLATE { TEMPLATE <templates/referenceIterators.rqg>(?jt, ?jr, CONCAT("k", ?h), ?rf, ?dialect) . }
    ITERATOR <iterators/joinConditions.rqg>(?om) AS ?h ?jt ?jr ?pt2 ?pr2 .
    "WHERE \{ "
    TEMPLATE <templates/termMap.rqg>(?st, ?sc, "", "s", "subject", ?rf, ?dialect, ?base) .
    TEMPLATE <templates/termMap.rqg>(?pt, ?pc, "", "p", "predicate", ?rf, ?dialect, ?base) WHERE { FILTER(?records) } .
    TEMPLATE { TEMPLATE <templates/termMap.rqg>(?jt, <urn:x-rml2sg:none>, ?jr, CONCAT("k", ?h), "key", ?rf, ?dialect, ?base) . }
    ITERATOR <iterators/joinConditions.rqg>(?om) AS ?h ?jt ?jr ?pt2 ?pr2 .
    TEMPLATE <templates/compositeKey.rqg>(?om, "k") .
    TEMPLATE { "BIND(BNODE() AS ?cn) " } WHERE { FILTER(?graphs) } .
    TEMPLATE { TEMPLATE <templates/termMap.rqg>(?gt, <urn:x-rml2sg:none>, "", CONCAT("g_", ?h), "graph", ?rf, ?dialect, ?base) . }
    ITERATOR <iterators/graphMaps.rqg>(?tm, ?pom) AS ?h ?gt
    WHERE { FILTER(?rf = "CSV") } .
    "} .\n"
  } WHERE { FILTER(!?stream) } .
  "  } .\n"

  # R9: the iteration of the child at the level of the join, its key bound on
  # each row (a missing key is an IRI, which no key equals) and looked up
  TEMPLATE {
    "  "
    TEMPLATE <templates/iteration.rqg>(?tm, "child", ?pom, ?om, ?rf) .
    "\n  "
    TEMPLATE <templates/referenceIterators.rqg>(?st, "", "s", ?rf, ?dialect) .
    TEMPLATE { TEMPLATE <templates/referenceIterators.rqg>(?jt, ?jr, CONCAT("kx", ?h), ?rf, ?dialect) . }
    ITERATOR <iterators/joinConditions.rqg>(?om) AS ?h ?jt ?jr ?pt2 ?pr2 .
    "\n  WHERE \{ "
    TEMPLATE <templates/termMap.rqg>(?st, ?sc, "", "s", "subject", ?rf, ?dialect, ?base) .
    TEMPLATE { TEMPLATE <templates/termMap.rqg>(?jt, <urn:x-rml2sg:none>, ?jr, CONCAT("kx", ?h), "key", ?rf, ?dialect, ?base) . }
    ITERATOR <iterators/joinConditions.rqg>(?om) AS ?h ?jt ?jr ?pt2 ?pr2 .
    TEMPLATE <templates/compositeKey.rqg>(?om, "kx") .
    TEMPLATE { "BIND(COALESCE(?kx" ?h ", <urn:x-rml2sg:none>) AS ?x" ?h ") ?o <urn:x-rml2sg:parent_" ?h "> ?x" ?h " ." }
    ITERATOR <iterators/joinKeys.rqg>(?om) AS ?h .
    "\n    "
    TEMPLATE <templates/termMap.rqg>(?pt, ?pc, "", "p", "predicate", ?rf, ?dialect, ?base) .
    "\n  } .\n"
  } WHERE { FILTER(?stream) } .

  # the join of the two graphs
  TEMPLATE {
    "  WHERE \{"
    TEMPLATE { " ?c <urn:x-rml2sg:subject> ?s ; <urn:x-rml2sg:predicate> ?p . ?r <urn:x-rml2sg:subject> ?o ." }
    WHERE { FILTER(?records) } .
    TEMPLATE { " " ?cvar " <urn:x-rml2sg:child_" ?h "> ?x" ?h " . " ?pvar " <urn:x-rml2sg:parent_" ?h "> ?x" ?h " ." }
    ITERATOR <iterators/joinKeys.rqg>(?om) AS ?h .
    TEMPLATE { " ?s <urn:x-rml2sg:child> true . ?o <urn:x-rml2sg:parent> true ." } WHERE { FILTER(!?keys) } .
    TEMPLATE { " OPTIONAL \{ ?c <urn:x-rml2sg:graph_" ?h "> ?g_" ?h " }" }
    ITERATOR <iterators/graphMaps.rqg>(?tm, ?pom) AS ?h ?gt .
    "\n    "
    TEMPLATE <templates/termMap.rqg>(?pt, ?pc, "", "p", "predicate", ?rf, ?dialect, ?base) WHERE { FILTER(!?records) } .
    "\n  } .\n"
  } WHERE { FILTER(!?stream) } .
}
WHERE {
  ?om (rr:parentTriplesMap|rmlc:parentTriplesMap) ?ptm .
  OPTIONAL { ?ptm (rr:subjectMap|rmlc:subjectMap) ?psm0 }
  BIND(COALESCE(?psm0, <urn:x-rml2sg:none>) AS ?psm)
  OPTIONAL { ?tm (rr:subjectMap|rmlc:subjectMap) ?sm0 }
  OPTIONAL { ?tm (rr:subject|rmlc:subject) ?sc0 }
  BIND(COALESCE(?sm0, <urn:x-rml2sg:none>) AS ?st)
  BIND(COALESCE(?sc0, <urn:x-rml2sg:none>) AS ?sc)
  BIND(IF(isIRI(?tm), CONCAT("<", STR(?tm), ">"), "[]") AS ?tmText)
  BIND(IF(isIRI(?ptm), CONCAT("<", STR(?ptm), ">"), "[]") AS ?ptmText)
  # one node per iteration when the predicate or a graph depends on the child
  # iteration; direct key triples otherwise (several conditions: one composite
  # key, iterators/joinKeys.rqg)
  BIND(EXISTS { ?om (rr:joinCondition|rmlc:joinCondition) ?j1 } AS ?keys)
  # graph maps with an expression, in the subject map or in ?pom
  BIND(EXISTS { { ?st (rr:graphMap|rmlc:graphMap) ?gm } UNION { ?pom (rr:graphMap|rmlc:graphMap) ?gm }
                ?gm (rr:template|rmlc:template|rml:reference|rmlc:reference|rr:column|rmlc:functionExecution) ?gv } AS ?graphs)
  BIND((EXISTS { ?pt (rr:template|rmlc:template|rml:reference|rmlc:reference) ?pv } || ?graphs) AS ?records)
  # rewriting R9 (README.md): the child, a CSV source (not a logical view),
  # is read as a stream when the join has a constant predicate, no graph map
  # with an expression (the direct form), conditions given as references, and
  # when the parent's subject depends on the parent's references of the
  # conditions only (an IRI template whose references are all among them, at
  # least one; or one of them): each child row then finds at most one parent
  # subject, and the join costs the rows of the child. It is exact in any
  # case: the parent side is the same graph, and a row of the child generates
  # the triples of its key (one condition) or of its composite key (several,
  # templates/compositeKey.rqg) that the graph of the child keys would.
  BIND(!?records && ?keys && ?rf = "CSV"
       && NOT EXISTS { ?tm (rml:logicalSource|rmlc:logicalSource)/rmlc:viewOn ?anyView }
       && NOT EXISTS { ?om (rr:joinCondition|rmlc:joinCondition)/(rmlc:childMap|rmlc:parentMap) ?anyJm }
       && NOT EXISTS { ?psm (rmlc:functionExecution|rmlc:condition|rmlc:quotedTriplesMap|rmlc:gather) ?anyPf }
       && NOT EXISTS { ?psm (rr:termType|rmlc:termType) ?ptt FILTER(?ptt IN (rr:BlankNode, rmlc:BlankNode, rr:Literal, rmlc:Literal)) }
       # the parent subject depends on the parent references of the conditions
       # only (rml2sparql-generate.rqg, urn:x-rml2sg:parentOnKey)
       && EXISTS { ?om <urn:x-rml2sg:parentOnKey> true } AS ?stream)
  BIND(IF(?graphs, "?cn", IF(?records, "_:c", "?s")) AS ?cnode)
  BIND(IF(?records, "_:r", "?o") AS ?pnode)
  # in the join pattern, the iteration nodes are variables
  BIND(IF(?records, "?c", "?s") AS ?cvar)
  BIND(IF(?records, "?r", "?o") AS ?pvar)
}
