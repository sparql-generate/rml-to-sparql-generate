# τ for a referencing object map ?om of predicate-object map ?pom of triples
# map ?tm, with a join condition or over another logical source than its
# parent. One sub-query at the top level of the generated query: both sides
# are first generated as a graph, then joined by a basic graph pattern.
#
#   GENERATE { ?s ?p ?o . }
#   FROM GENERATE {
#     GENERATE { ?o <urn:x-rml2sg:parent_h> ?q_h . } <parent iteration> WHERE { ... } .
#     GENERATE { ?s <urn:x-rml2sg:child_h> ?k_h . }  <child iteration>  WHERE { ... } .
#   } .
#   WHERE { ?s <urn:x-rml2sg:child_h> ?x . ?o <urn:x-rml2sg:parent_h> ?x . BIND(<p> AS ?p) }
#
# A graph is a set: a child subject with the same key in many iterations is
# one triple, so the join costs the size of its result, not the product of
# the iterations that share a key (shapes and their points in GTFS). With
# several join conditions, or a predicate that depends on the child
# iteration, each iteration is a node (_:c, _:r) with its subject, predicate
# and keys. A missing key value generates no key triple, hence no join; keys
# are compared as strings (iterators/joinConditions.rqg names each condition).
# rml-translation.md (Section 6) iterates over the parent for each child
# iteration instead: the set of triples is the same.
PREFIX rr:   <http://www.w3.org/ns/r2rml#>
PREFIX rml:  <http://semweb.mmlab.be/ns/rml#>
PREFIX rmlc: <http://w3id.org/rml/>

TEMPLATE <templates/join.rqg>(?tm, ?pom, ?pt, ?pc, ?om, ?rf, ?prf, ?dialect, ?base, ?pbase) {
  "\n  # " ?tmText " → " ?ptmText "\n"
  "  GENERATE \{ ?s ?p ?o . }\n"
  "  FROM GENERATE \{\n"

  # the parent side
  "    GENERATE \{"
  TEMPLATE { " " ?pnode " <urn:x-rml2sg:parent_" ?h "> ?q" ?h " ." }
  ITERATOR <iterators/joinConditions.rqg>(?om) AS ?h ?ct ?cr ?jt ?jr .
  TEMPLATE { " _:r <urn:x-rml2sg:subject> ?o ." } WHERE { FILTER(?records) } .
  TEMPLATE { " ?o <urn:x-rml2sg:parent> true ." } WHERE { FILTER(!?keys) } .
  " }\n      "
  TEMPLATE <templates/iteration.rqg>(?ptm, "parent", ?pom, ?om, ?prf) .
  "\n      "
  TEMPLATE <templates/referenceIterators.rqg>(?psm, "", "o", ?prf, ?dialect) .
  TEMPLATE { TEMPLATE <templates/referenceIterators.rqg>(?jt, ?jr, CONCAT("q", ?h), ?prf, ?dialect) . }
  ITERATOR <iterators/joinConditions.rqg>(?om) AS ?h ?ct ?cr ?jt ?jr .
  "WHERE \{ "
  TEMPLATE <templates/termMap.rqg>(?psm, <urn:x-rml2sg:none>, "", "o", "subject", ?prf, ?dialect, ?pbase) .
  TEMPLATE { TEMPLATE <templates/termMap.rqg>(?jt, <urn:x-rml2sg:none>, ?jr, CONCAT("q", ?h), "key", ?prf, ?dialect, ?pbase) . }
  ITERATOR <iterators/joinConditions.rqg>(?om) AS ?h ?ct ?cr ?jt ?jr .
  "} .\n"

  # the child side
  "    GENERATE \{"
  TEMPLATE { " " ?cnode " <urn:x-rml2sg:child_" ?h "> ?k" ?h " ." }
  ITERATOR <iterators/joinConditions.rqg>(?om) AS ?h ?jt ?jr ?pt2 ?pr2 .
  TEMPLATE { " _:c <urn:x-rml2sg:subject> ?s ; <urn:x-rml2sg:predicate> ?p ." } WHERE { FILTER(?records) } .
  TEMPLATE { " ?s <urn:x-rml2sg:child> true ." } WHERE { FILTER(!?keys) } .
  " }\n      "
  TEMPLATE <templates/iteration.rqg>(?tm, "child", ?pom, ?om, ?rf) .
  "\n      "
  TEMPLATE <templates/referenceIterators.rqg>(?st, "", "s", ?rf, ?dialect) .
  TEMPLATE <templates/referenceIterators.rqg>(?pt, "", "p", ?rf, ?dialect) WHERE { FILTER(?records) } .
  TEMPLATE { TEMPLATE <templates/referenceIterators.rqg>(?jt, ?jr, CONCAT("k", ?h), ?rf, ?dialect) . }
  ITERATOR <iterators/joinConditions.rqg>(?om) AS ?h ?jt ?jr ?pt2 ?pr2 .
  "WHERE \{ "
  TEMPLATE <templates/termMap.rqg>(?st, ?sc, "", "s", "subject", ?rf, ?dialect, ?base) .
  TEMPLATE <templates/termMap.rqg>(?pt, ?pc, "", "p", "predicate", ?rf, ?dialect, ?base) WHERE { FILTER(?records) } .
  TEMPLATE { TEMPLATE <templates/termMap.rqg>(?jt, <urn:x-rml2sg:none>, ?jr, CONCAT("k", ?h), "key", ?rf, ?dialect, ?base) . }
  ITERATOR <iterators/joinConditions.rqg>(?om) AS ?h ?jt ?jr ?pt2 ?pr2 .
  "} .\n  } .\n"

  # the join
  "  WHERE \{"
  TEMPLATE { " ?c <urn:x-rml2sg:subject> ?s ; <urn:x-rml2sg:predicate> ?p . ?r <urn:x-rml2sg:subject> ?o ." }
  WHERE { FILTER(?records) } .
  TEMPLATE { " " ?cvar " <urn:x-rml2sg:child_" ?h "> ?x" ?h " . " ?pvar " <urn:x-rml2sg:parent_" ?h "> ?x" ?h " ." }
  ITERATOR <iterators/joinConditions.rqg>(?om) AS ?h ?ct ?cr ?jt ?jr .
  TEMPLATE { " ?s <urn:x-rml2sg:child> true . ?o <urn:x-rml2sg:parent> true ." } WHERE { FILTER(!?keys) } .
  "\n    "
  TEMPLATE <templates/termMap.rqg>(?pt, ?pc, "", "p", "predicate", ?rf, ?dialect, ?base) WHERE { FILTER(!?records) } .
  "\n  } .\n"
}
WHERE {
  ?om (rr:parentTriplesMap|rmlc:parentTriplesMap) ?ptm .
  OPTIONAL { ?ptm (rr:subjectMap|rmlc:subjectMap) ?psm0 }
  BIND(COALESCE(?psm0, <urn:x-rml2sg:none>) AS ?psm)
  OPTIONAL { ?tm (rr:subjectMap|rmlc:subjectMap) ?sm0 }
  OPTIONAL { ?tm (rr:subject|rmlc:subject) ?sc0 }
  BIND(COALESCE(?sm0, <urn:x-rml2sg:none>) AS ?st)
  BIND(COALESCE(?sc0, <urn:x-rml2sg:none>) AS ?sc)
  BIND(IF(isIRI(?tm), CONCAT("<", STR(?tm), ">"), "[]") AS ?tmText)
  BIND(IF(isIRI(?ptm), CONCAT("<", STR(?ptm), ">"), "[]") AS ?ptmText)
  # one node per iteration when there are several keys or when the predicate
  # depends on the child iteration; direct key triples otherwise
  BIND(EXISTS { ?om (rr:joinCondition|rmlc:joinCondition) ?j1 } AS ?keys)
  BIND((EXISTS { ?om (rr:joinCondition|rmlc:joinCondition) ?j2, ?j3 . FILTER(?j2 != ?j3) }
        || EXISTS { ?pt (rr:template|rmlc:template|rml:reference|rmlc:reference) ?pv }) AS ?records)
  BIND(IF(?records, "_:c", "?s") AS ?cnode)
  BIND(IF(?records, "_:r", "?o") AS ?pnode)
  # in the join pattern, the iteration nodes are variables
  BIND(IF(?records, "?c", "?s") AS ?cvar)
  BIND(IF(?records, "?r", "?o") AS ?pvar)
}
