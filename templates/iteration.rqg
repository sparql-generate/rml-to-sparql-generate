# The iteration over the logical source of triples map ?tm:
#
#   CSV       ITERATOR iter:CSV(<file>, 10000, "r1", ..., "rn") AS ?c_<md5(r1)> ...
#             one solution per row, binding the columns used by the term maps
#             of ?scope (see iterators/pieces.rqg); an empty cell is unbound;
#             RML-IO (http://w3id.org/rml/): iter:CSVStrict, where an empty
#             cell is the empty string and a row whose number of fields is not
#             that of the header is a data error;
#             SPARQL results (RML-IO): iter:SPARQL(<file>, "<query>", "r1", ...)
#             AS ?c_<md5(r1)> ..., one solution of the query per row, the
#             references naming its variables, their values the RDF terms;
#             read in batches of 10 000 rows (rewriting R4: the generated queries have
#             no solution modifier, so a GENERATE gives the union of what each
#             batch gives, and a streamed output is written batch by batch);
#   JSONPath  ITERATOR iter:JSONPath(<file>, "<iterator>") AS ?it
#   XPath     ITERATOR iter:XPath(<file>, "<iterator>", "r1", ...) AS ?it ?xp_<md5(r1)> ...
#             the references that leave the iterated node (parent, ancestor,
#             sibling axes: "../@id") evaluated from the node in its document,
#             as sub-queries of the iteration (templates/referenceIterator.rqg);
#
# The file is named by an IRI: relative paths are resolved against the BASE of
# the generated query, which the command line maps to the working directory
# (-b); absolute paths become file: IRIs.
PREFIX rr:   <http://www.w3.org/ns/r2rml#>
PREFIX rml:  <http://semweb.mmlab.be/ns/rml#>
PREFIX rmlc: <http://w3id.org/rml/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>

TEMPLATE <templates/iteration.rqg>(?tm, ?scope, ?pom, ?om, ?rf) {

  TEMPLATE {
    "ITERATOR " ?csvIter "(" ?srcText ?csvArgs
    TEMPLATE { ", " ?col }
    ITERATOR <iterators/references.rqg>(?rscope, ?tm, ?pom, ?om) AS ?r
    WHERE { BIND(CONCAT("\"", REPLACE(REPLACE(REPLACE(?r, "\\\\", "\\\\\\\\"), "\"", "\\\\\""), "\\\{", "\\\\\{"), "\"") AS ?col) } .
    ") AS"
    TEMPLATE { " ?" ?colvar0 MD5(?r) }
    ITERATOR <iterators/references.rqg>(?rscope, ?tm, ?pom, ?om) AS ?r .
    # an iterator binds at least one variable: without reference (constant
    # term maps only), the first column, positionally
    TEMPLATE { " ?c_" }
    WHERE {
      FILTER(?rscope = "tm")
      FILTER NOT EXISTS {
        { ?tm (rr:subjectMap|rmlc:subjectMap) ?t }
        UNION { ?tm (rr:subjectMap|rmlc:subjectMap)/(rr:graphMap|rmlc:graphMap) ?t }
        UNION { ?tm (rr:predicateObjectMap|rmlc:predicateObjectMap)/(rr:predicateMap|rmlc:predicateMap|rr:objectMap|rmlc:objectMap|rr:graphMap|rmlc:graphMap) ?t }
        UNION { ?tm (rr:predicateObjectMap|rmlc:predicateObjectMap)/(rr:objectMap|rmlc:objectMap)/(rmlc:languageMap|rmlc:datatypeMap) ?t }
        UNION { ?tm (rr:predicateObjectMap|rmlc:predicateObjectMap)/(rr:objectMap|rmlc:objectMap)/(rr:parentTriplesMap|rmlc:parentTriplesMap)/(rr:subjectMap|rmlc:subjectMap) ?t }
        UNION { ?tm ((rr:subjectMap|rmlc:subjectMap)|(rr:predicateObjectMap|rmlc:predicateObjectMap)/(rr:objectMap|rmlc:objectMap))/(rmlc:quotedTriplesMap/(rmlc:subjectMap|rmlc:predicateObjectMap/(rmlc:predicateMap|rmlc:objectMap)))+ ?t }
        UNION { ?tm ((rr:subjectMap|rmlc:subjectMap)|(rr:predicateObjectMap|rmlc:predicateObjectMap)/(rr:objectMap|rmlc:objectMap))/rmlc:joinCondition/rmlc:childMap ?t }
        ?t (rmlc:functionExecution/rmlc:input/rmlc:inputValueMap|rmlc:condition)*/(rr:template|rmlc:template|rml:reference|rmlc:reference|rr:column) ?x
      }
      FILTER NOT EXISTS { ?tm ((rr:subjectMap|rmlc:subjectMap)|(rr:predicateObjectMap|rmlc:predicateObjectMap)/(rr:objectMap|rmlc:objectMap))/rmlc:joinCondition/rmlc:child ?y }
    } .
    # the position of the row (gather maps: scopes tmpos, parentpos)
    TEMPLATE { " ?ipos" } WHERE { FILTER(?pos) } .
    # RML-IO, rml:null: a value among the null values of the source is no value
    TEMPLATE { " BIND(IF(STR(?n" ?colvar MD5(?r) ") IN (" ?nullList "), ?none, ?n" ?colvar MD5(?r) ") AS ?" ?colvar MD5(?r) ")" }
    ITERATOR <iterators/references.rqg>(?rscope, ?tm, ?pom, ?om) AS ?r
    WHERE { FILTER(BOUND(?nullList)) } .
  } WHERE { FILTER(?rf = "CSV" && !?view) } .

  # a logical view (RML-LV): its iteration, the keys as columns, and its joins
  TEMPLATE {
    TEMPLATE <templates/viewJoins.rqg>(?ls, "graphs") .
    TEMPLATE <templates/viewIteration.rqg>(?ls, ?colvar, 0) .
  } WHERE { FILTER(?view) } .

  TEMPLATE { "ITERATOR iter:JSONPath(" ?srcText ", " ?itText ") AS ?it" ?posText }
  WHERE { FILTER(?rf = "JSONPath") } .

  TEMPLATE {
    "ITERATOR iter:XPath(" ?srcText ", " ?itText
    TEMPLATE { ", " ?subText }
    ITERATOR <iterators/references.rqg>(?rscope, ?tm, ?pom, ?om) AS ?r
    WHERE {
      FILTER(REGEX(?r, "(^|/)\\.\\.(/|$)|(parent|ancestor|ancestor-or-self|preceding|following|preceding-sibling|following-sibling)::"))
      BIND(IF(REGEX(?r, "(@[^/]*|\\)|text\\(\\))$"), ?r, CONCAT(?r, "/text()")) AS ?sub)
      BIND(CONCAT("\"", REPLACE(REPLACE(REPLACE(?sub, "\\\\", "\\\\\\\\"), "\"", "\\\\\""), "\\\{", "\\\\\{"), "\"") AS ?subText)
    } .
    ") AS ?it"
    TEMPLATE { " ?xp_" MD5(?r) }
    ITERATOR <iterators/references.rqg>(?rscope, ?tm, ?pom, ?om) AS ?r
    WHERE { FILTER(REGEX(?r, "(^|/)\\.\\.(/|$)|(parent|ancestor|ancestor-or-self|preceding|following|preceding-sibling|following-sibling)::")) } .
    ?posText
  } WHERE { FILTER(?rf = "XPath") } .
}
WHERE {
  # "jparent": the parent iterated inside its child's iteration, its columns
  # named ?jc_ (templates/joinInIteration.rqg)
  BIND(IF(?scope IN ("jparent", "parentpos"), "parent", IF(?scope = "tmpos", "tm", ?scope)) AS ?rscope)
  # the position of the iteration, as ?ipos (gather maps)
  BIND(?scope IN ("tmpos", "parentpos") AS ?pos)
  BIND(IF(?pos, " ?ipos", "") AS ?posText)
  # RML-IO: CSV read strictly; SPARQL results (rml2sparql-generate.rqg)
  BIND(EXISTS { ?ls <urn:x-rml2sg:sparqlResults> true } AS ?sparql)
  BIND(IF(?sparql, "iter:SPARQL", IF(EXISTS { ?tm rmlc:logicalSource ?anyls }, "iter:CSVStrict", "iter:CSV")) AS ?csvIter)
  BIND(IF(?scope = "jparent", "jc_", "c_") AS ?colvar)
  # without logical source (?rf "NONE"): no iterator
  OPTIONAL { ?tm (rml:logicalSource|rmlc:logicalSource) ?ls }
  BIND(EXISTS { ?tm rmlc:logicalSource/rmlc:viewOn ?anyv } AS ?view)
  OPTIONAL { ?ls (rml:source|rmlc:source) ?src . FILTER(isLiteral(?src)) }
  # RML-IO: the null values of the source (rml:null), the columns then read as ?n<colvar>...
  OPTIONAL { { SELECT ?ls (GROUP_CONCAT(CONCAT("\"", REPLACE(REPLACE(STR(?nv), "\\\\", "\\\\\\\\"), "\"", "\\\\\""), "\"") ; separator=", ") AS ?nullList)
               WHERE { ?ls rmlc:source/rmlc:null ?nv } GROUP BY ?ls } }
  BIND(IF(BOUND(?nullList), CONCAT("n", ?colvar), ?colvar) AS ?colvar0)
  OPTIONAL { ?ls (rml:source|rmlc:source)/(rmlc:path|rmlc:file) ?p }
  BIND(COALESCE(STR(?p), STR(?src)) AS ?path)
  BIND(IF(REGEX(?path, "^[A-Za-z][A-Za-z0-9+.-]*:"), ?path,
       IF(STRSTARTS(?path, "/"), CONCAT("file://", ?path), ?path)) AS ?iri)
  BIND(CONCAT("<", REPLACE(?iri, " ", "%20"), ">") AS ?srcText)
  OPTIONAL { ?ls (rml:iterator|rmlc:iterator) ?iterator0 }
  BIND(COALESCE(STR(?iterator0), IF(?rf = "JSONPath", "$", "/*")) AS ?iterator)
  BIND(CONCAT("\"", REPLACE(REPLACE(REPLACE(?iterator, "\\\\", "\\\\\\\\"), "\"", "\\\\\""), "\\\{", "\\\\\{"), "\"") AS ?itText)
  # the query of SPARQL results, on several lines: a long string
  BIND(CONCAT("\"\"\"", REPLACE(REPLACE(REPLACE(?iterator, "\\\\", "\\\\\\\\"), "\"", "\\\\\""), "\\\{", "\\\\\{"), "\"\"\"") AS ?qText)
  BIND(IF(?sparql, CONCAT(", ", ?qText), ", 10000") AS ?csvArgs)
}
