# The binding clauses of the fields of ?parent (a logical view or a field,
# RML-LV), evaluated on record ?rec (the text of a variable) of reference
# formulation ?rf ("JSONPath", "XPath"; "CSV": a row, ?rec is then the prefix
# of the variables of its columns, ?<rec><md5(column)>; "VIEW": the iteration
# of the logical view ?parent is on, whose keys are ?<VP><md5(key)>). A field named n under the path ?path has
# the key k = <path>n, its value in ?<P><md5(k)> and its index in
# ?<P><md5(k.#)>:
#
#   expression field, reference   an iterator over the record (one solution
#                                 per value, its position as index; JSONPath:
#                                 one solution with a null value and index
#                                 when there is no value, as RML-LV keeps the
#                                 iteration with a null value; CSV and
#                                 VIEW: the value, index 0, or the index of
#                                 the key referenced)
#   expression field, template    the iterators of its references, then the text
#   expression field, constant    the constant, index 0
#   iterable field                an iterator over the record (rml:iterator);
#                                 in CSV (rml:referenceFormulation), iter:CSV
#                                 over the text of the record
#
# The fields of a field are evaluated on its records: the iterated records of
# an iterable field, the values of an expression field, in the reference
# formulation of the field (rml:referenceFormulation) or of its parent. ?depth
# bounds the nesting (a cycle is reported by templates/checks.rqg).
PREFIX rmlc: <http://w3id.org/rml/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

TEMPLATE <templates/viewFields.rqg>(?parent, ?rec, ?rf, ?path, ?P, ?VP, ?depth) {
  TEMPLATE {
    # expression field, reference
    # (a record without value, or no record: one iteration, the value and
    # the index null, RMLLVTC0010b)
    TEMPLATE { "BIND(COALESCE(STR(fun:JSONPath(" ?rec ", " ?pathText ")) = \"[]\", true) AS ?" ?P "e" ?hv ") "
               "ITERATOR iter:JSONPath(IF(?" ?P "e" ?hv ", \"[null]\", " ?rec "), IF(?" ?P "e" ?hv ", \"$[*]\", " ?pathText "), \"$\") AS ?" ?P "r" ?hv " ?" ?P ?hv " ?" ?P "i" ?hv " "
               "BIND(IF(?" ?P "e" ?hv ", ?none, ?" ?P "i" ?hv ") AS ?" ?P ?hi ")\n    " }
    WHERE { FILTER(BOUND(?r) && ?rf = "JSONPath") } .
    TEMPLATE { "ITERATOR iter:XPath(" ?rec ", " ?pathText ") AS ?" ?P "r" ?hv " ?" ?P ?hi " BIND(?" ?P "r" ?hv " AS ?" ?P ?hv ")\n    " }
    WHERE { FILTER(BOUND(?r) && ?rf = "XPath") } .
    TEMPLATE { "BIND(?" ?rec MD5(?r) " AS ?" ?P ?hv ") BIND(0 AS ?" ?P ?hi ")\n    " }
    WHERE { FILTER(BOUND(?r) && ?rf = "CSV") } .
    TEMPLATE { "BIND(?" ?VP MD5(?r) " AS ?" ?P ?hv ") BIND(COALESCE(?" ?VP MD5(CONCAT(?r, ".#")) ", 0) AS ?" ?P ?hi ")\n    " }
    WHERE { FILTER(BOUND(?r) && ?rf = "VIEW") } .
    # expression field, constant
    TEMPLATE { "BIND(" ?constText " AS ?" ?P ?hv ") BIND(0 AS ?" ?P ?hi ")\n    " }
    WHERE { FILTER(BOUND(?c)) } .
    # expression field, template
    TEMPLATE {
      TEMPLATE { "ITERATOR " ?call " AS ?" ?P "t" ?hv "raw" MD5(?tref) " ?" ?P "t" ?hv "_" MD5(?tref) "\n    " }
      ITERATOR iter:regex(?tpl, "((?:[^\{}\\\\]|\\\\.)*)(\\\{(?:[^\{}\\\\]|\\\\.)*}|$)", 2) AS ?g
      WHERE {
        FILTER(STRLEN(?g) > 0 && ?rf IN ("JSONPath", "XPath"))
        BIND(REPLACE(SUBSTR(?g, 2, STRLEN(?g) - 2), "\\\\(.)", "$1") AS ?tref)
        BIND(IF(STRSTARTS(?tref, "$"), ?tref, CONCAT("$.", ?tref)) AS ?tj)
        BIND(IF(STRSTARTS(?tref, "/"), ?tref, CONCAT("/*/", ?tref, "/text()")) AS ?tx)
        BIND(CONCAT("\"", REPLACE(REPLACE(REPLACE(IF(?rf = "JSONPath", ?tj, ?tx), "\\\\", "\\\\\\\\"), "\"", "\\\\\""), "\\\{", "\\\\\{"), "\"") AS ?tText)
        BIND(IF(?rf = "JSONPath", CONCAT("iter:JSONPath(", ?rec, ", ", ?tText, ", \"$\")"), CONCAT("iter:XPath(", ?rec, ", ", ?tText, ")")) AS ?call0)
        # iter:XPath binds one variable: the raw value is the value
        BIND(?call0 AS ?call)
      } GROUP BY ?tref ?call ?P ?hv .
      "BIND(" TEMPLATE <templates/viewText.rqg>(?tpl, ?tprefix) . " AS ?" ?P ?hv ") BIND(0 AS ?" ?P ?hi ")\n    "
    } WHERE {
      FILTER(BOUND(?tpl))
      BIND(IF(?rf IN ("JSONPath", "XPath"), IF(?rf = "XPath", CONCAT(?P, "t", ?hv, "raw"), CONCAT(?P, "t", ?hv, "_")),
           IF(?rf = "CSV", ?rec, ?VP)) AS ?tprefix)
    } .
    # iterable field
    TEMPLATE { "ITERATOR iter:" ?rfIter "(" ?rec ", " ?itText ") AS ?" ?P "r" ?hv " ?" ?P ?hi "\n    " }
    WHERE { FILTER(BOUND(?it0) && ?frf != "CSV") BIND(IF(?frf = "XPath", "XPath", "JSONPath") AS ?rfIter) } .
    # iterable field over CSV text: its rows, the columns that its fields read
    # (the position of the row as index, SPARQL-Generate 2.4.2)
    TEMPLATE {
      "ITERATOR iter:CSV(" ?rec
      TEMPLATE { ", " ?colText }
      ITERATOR <iterators/viewColumns.rqg>(?f) AS ?col
      WHERE { BIND(CONCAT("\"", REPLACE(REPLACE(REPLACE(?col, "\\\\", "\\\\\\\\"), "\"", "\\\\\""), "\\\{", "\\\\\{"), "\"") AS ?colText) } .
      ") AS"
      TEMPLATE { " ?" ?nrec MD5(?col) }
      ITERATOR <iterators/viewColumns.rqg>(?f) AS ?col .
      " ?" ?P ?hi "\n    "
    } WHERE { FILTER(?frf = "CSV" && ?rf != "CSV" && NOT EXISTS { ?f rmlc:reference|rmlc:template|rmlc:constant ?anon1 }) } .
    # the nested fields, on the records of the field
    TEMPLATE <templates/viewFields.rqg>(?f, ?nrec, ?frf, CONCAT(?k, "."), ?P, ?VP, ?depth + 1)
    WHERE { FILTER(?depth < 8) } .
  }
  WHERE {
    ?parent rmlc:field ?f .
    ?f rmlc:fieldName ?n .
    BIND(CONCAT(?path, STR(?n)) AS ?k)
    BIND(MD5(?k) AS ?hv)
    BIND(MD5(CONCAT(?k, ".#")) AS ?hi)
    OPTIONAL { ?f rmlc:reference ?r0 }
    BIND(STR(?r0) AS ?r)
    OPTIONAL { ?f rmlc:template ?tpl0 }
    BIND(STR(?tpl0) AS ?tpl)
    OPTIONAL { ?f rmlc:constant ?c }
    OPTIONAL { ?f rmlc:iterator ?it0 }
    OPTIONAL { ?f rmlc:referenceFormulation ?frf0 }
    BIND(COALESCE(REPLACE(STR(?frf0), "^.*[#/]", ""), ?rf) AS ?frf)
    BIND(IF(STRSTARTS(?r, "$"), ?r,
         IF(REGEX(?r, "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"), CONCAT("$.", ?r),
            CONCAT("$['", REPLACE(?r, "'", "\\\\'"), "']"))) AS ?jsonPath)
    BIND(IF(STRSTARTS(?r, "/"), ?r, CONCAT("/*/", ?r)) AS ?xpath0)
    BIND(IF(REGEX(?xpath0, "(@[^/]*|\\)|text\\(\\))$"), ?xpath0, CONCAT(?xpath0, "/text()")) AS ?xpath)
    BIND(CONCAT("\"", REPLACE(REPLACE(REPLACE(IF(?rf = "XPath", ?xpath, ?jsonPath), "\\\\", "\\\\\\\\"), "\"", "\\\\\""), "\\\{", "\\\\\{"), "\"") AS ?pathText)
    BIND(CONCAT("\"", REPLACE(REPLACE(REPLACE(STR(?it0), "\\\\", "\\\\\\\\"), "\"", "\\\\\""), "\\\{", "\\\\\{"), "\"") AS ?itText)
    # the records of the nested fields
    BIND(IF(?frf = "CSV" && ?rf != "CSV", CONCAT(?P, "i", ?hv, "col"),
         IF(BOUND(?it0) || (BOUND(?r) && ?rf IN ("JSONPath", "XPath")), CONCAT("?", ?P, "r", ?hv), CONCAT("?", ?P, ?hv))) AS ?nrec)
    BIND(IF(isIRI(?c), CONCAT("<", STR(?c), ">"),
         CONCAT("\"", REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(STR(?c), "\\\\", "\\\\\\\\"), "\"", "\\\\\""), "\n", "\\\\n"), "\r", "\\\\r"), "\\\{", "\\\\\{"), "\"",
                IF(LANG(?c) != "", CONCAT("@", LANG(?c)),
                IF(DATATYPE(?c) != xsd:string, CONCAT("^^<", STR(DATATYPE(?c)), ">"), ""))))
         AS ?constText)
  } .
}
WHERE { }
