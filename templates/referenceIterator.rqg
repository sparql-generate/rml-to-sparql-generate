# The iterator clause of one reference ?r in role ?role (JSONPath, XPath).
#
# JSONPath: RML 1.x references are member names ("Name", "Country Code"),
# RML-Core references are JSONPath expressions relative to the iteration
# ("$.Name"). The auxiliary query "$" returns the value with its natural
# datatype (number, boolean, string).
# XPath: the iteration ?it is the serialised element, re-parsed by the
# iterator, so a relative path r becomes "/*/r"; a path to an element reads
# its text. A path that leaves the element (../@id) is read by the iteration
# itself, from the element in its document.
# RML-Core, JSONPath: the auxiliary query "$[*]" gives ?<role>_ct<md5(r)>, the
# first member of a value that is an array or an object, and "[]" for a
# scalar: a reference to an array or an object is a data error
# (templates/termMap.rqg, RAISE).
PREFIX iter: <http://w3id.org/sparql-generate/iter/>

TEMPLATE <templates/referenceIterator.rqg>(?r, ?role, ?rf, ?dialect) {
  ?clause "\n    "
}
WHERE {
  BIND(MD5(?r) AS ?h)
  BIND(IF(STRSTARTS(?r, "$"), ?r,
       IF(REGEX(?r, "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"), CONCAT("$.", ?r),
          CONCAT("$['", REPLACE(?r, "'", "\\\\'"), "']"))) AS ?jsonPath)
  BIND(IF(STRSTARTS(?r, "/"), ?r, CONCAT("/*/", ?r)) AS ?xpath0)
  BIND(IF(REGEX(?xpath0, "(@[^/]*|\\)|text\\(\\))$"), ?xpath0, CONCAT(?xpath0, "/text()")) AS ?xpath)
  BIND(IF(?rf = "JSONPath", ?jsonPath, ?xpath) AS ?path)
  BIND(CONCAT("\"", REPLACE(REPLACE(REPLACE(?path, "\\\\", "\\\\\\\\"), "\"", "\\\\\""), "\\\{", "\\\\\{"), "\"") AS ?pathText)
  BIND(?rf = "JSONPath" && ?dialect = "rmlc" AS ?container)
  BIND(IF(?rf = "JSONPath",
          CONCAT("iter:JSONPath(?it, ", ?pathText, ", \"$\"", IF(?container, ", \"$[*]\"", ""), ")"),
          CONCAT("iter:XPath(?it, ", ?pathText, ")")) AS ?call)
  BIND(IF(?rf = "JSONPath",
          CONCAT("?", ?role, "_raw", ?h, " ?", ?role, "_", ?h, IF(?container, CONCAT(" ?", ?role, "_ct", ?h), "")),
          CONCAT("?", ?role, "_", ?h)) AS ?vars)
  # XPath: a reference that leaves the iterated node (parent, ancestor,
  # sibling axes) is a sub-query of the iteration, ?xp_<md5(r)>
  # (templates/iteration.rqg): the serialised element has no parent
  BIND(?rf = "XPath" && REGEX(?r, "(^|/)\\.\\.(/|$)|(parent|ancestor|ancestor-or-self|preceding|following|preceding-sibling|following-sibling)::") AS ?outside)
  BIND(IF(?outside, CONCAT("BIND(?xp_", ?h, " AS ?", ?role, "_", ?h, ")"), CONCAT("ITERATOR ", ?call, " AS ", ?vars)) AS ?clause)
}
