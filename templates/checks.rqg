# Static checks of the mapping: each violation is written as a line
# "#ERROR: <message>" at the top of the generated query, so that a caller can
# reject an invalid mapping (the query itself stays syntactically valid).
PREFIX rr:   <http://www.w3.org/ns/r2rml#>
PREFIX rml:  <http://semweb.mmlab.be/ns/rml#>
PREFIX rmlc: <http://w3id.org/rml/>
PREFIX ql:   <http://semweb.mmlab.be/ns/ql#>

TEMPLATE <templates/checks.rqg>(?dialect) {

  TEMPLATE { "#ERROR: triples map " ?tmText " has no subject map\n" }
  WHERE { ?tm (rml:logicalSource|rmlc:logicalSource) ?anon1 .
          FILTER NOT EXISTS { ?tm (rr:subjectMap|rmlc:subjectMap|rr:subject|rmlc:subject) ?anon2 }
          BIND(IF(isIRI(?tm), STR(?tm), "[]") AS ?tmText) } .

  TEMPLATE { "#ERROR: triples map " ?tmText " has several subject maps\n" }
  WHERE { ?tm (rr:subjectMap|rmlc:subjectMap|rr:subject|rmlc:subject) ?a, ?b . FILTER(?a != ?b)
          BIND(IF(isIRI(?tm), STR(?tm), "[]") AS ?tmText) } LIMIT 1 .

  TEMPLATE { "#ERROR: a subject map has term type Literal\n" }
  WHERE { ?anon3 (rr:subjectMap|rmlc:subjectMap)/(rr:termType|rmlc:termType) ?tt . FILTER(?tt IN (rr:Literal, rmlc:Literal)) } LIMIT 1 .

  TEMPLATE { "#ERROR: a predicate map or graph map does not generate IRIs\n" }
  WHERE { { ?anon4 (rr:predicateMap|rmlc:predicateMap|rr:graphMap|rmlc:graphMap)/(rr:termType|rmlc:termType) ?tt .
            FILTER(?tt IN (rr:Literal, rmlc:Literal, rr:BlankNode, rmlc:BlankNode)) }
          UNION
          # a literal graph name: rr:graph "g", rr:graphMap [ rr:constant "g" ]
          { ?anon9 ((rr:graphMap|rmlc:graphMap)/(rr:constant|rmlc:constant)|rr:graph|rmlc:graph) ?gl .
            FILTER(isLiteral(?gl)) } } LIMIT 1 .

  TEMPLATE { "#ERROR: invalid language tag \"" ?lang "\"\n" }
  WHERE { ?anon5 (rr:language|rmlc:language) ?l . BIND(STR(?l) AS ?lang)
          # BCP 47: a primary language subtag of 2 or 3 letters, then subtags
          FILTER(!REGEX(?lang, "^[A-Za-z]\{2,3}(-[A-Za-z0-9]\{1,8})*$")) } .

  TEMPLATE { "#ERROR: a constant-valued term map has an incompatible term type\n" }
  WHERE { ?t (rr:constant|rmlc:constant) ?c ; (rr:termType|rmlc:termType) ?tt .
          FILTER((isIRI(?c) && !(?tt IN (rr:IRI, rmlc:IRI, rmlc:URI, rmlc:UnsafeIRI)))
              || (isLiteral(?c) && !(?tt IN (rr:Literal, rmlc:Literal))))
  } LIMIT 1 .

  TEMPLATE { "#ERROR: invalid template \"" ?tpl "\"\n" }
  WHERE { ?anon6 (rr:template|rmlc:template) ?t . BIND(STR(?t) AS ?tpl)
          # balanced, non-nested, non-empty {references}, with \ escapes
          FILTER(!REGEX(?tpl, "^(?:[^\{}\\\\]|\\\\.)*(?:\\\{(?:[^\{}\\\\]|\\\\.)+}(?:[^\{}\\\\]|\\\\.)*)*$")) } .

  TEMPLATE { "#ERROR: invalid JSONPath \"" ?path "\"\n" }
  WHERE { ?tm (rml:logicalSource|rmlc:logicalSource) ?ls .
          ?ls (rml:referenceFormulation|rmlc:referenceFormulation) ?rf .
          FILTER(?rf IN (ql:JSONPath, rmlc:JSONPath))
          { ?ls (rml:iterator|rmlc:iterator) ?p }
          UNION
          { ?tm ((rr:subjectMap|rmlc:subjectMap)|((rr:predicateObjectMap|rmlc:predicateObjectMap)/
                 (rr:objectMap|rmlc:objectMap|rr:predicateMap|rmlc:predicateMap|rr:graphMap|rmlc:graphMap))) ?t .
            ?t (rml:reference|rmlc:reference) ?p }
          BIND(STR(?p) AS ?path)
          # brackets and parentheses balanced, outside quoted names
          BIND(REPLACE(?path, "'[^']*'|\"[^\"]*\"", "") AS ?bare)
          FILTER(STRLEN(REPLACE(?bare, "[^\\[]", "")) != STRLEN(REPLACE(?bare, "[^\\]]", ""))
              || STRLEN(REPLACE(?bare, "[^(]", "")) != STRLEN(REPLACE(?bare, "[^)]", ""))) } .

  TEMPLATE { "#ERROR: unsupported logical source (" ?what ")\n" }
  WHERE { ?tm (rml:logicalSource|rmlc:logicalSource) ?ls .
          OPTIONAL { ?ls (rml:referenceFormulation|rmlc:referenceFormulation) ?rfi }
          BIND(COALESCE(REPLACE(STR(?rfi), "^.*[#/]", ""), "no reference formulation") AS ?what)
          FILTER(!(?what IN ("CSV", "JSONPath", "XPath")))
          FILTER NOT EXISTS { ?ls rmlc:viewOn ?anon13 } } .

  # RML-star: a star map is a subject map or an object map
  TEMPLATE { "#ERROR: rml:quotedTriplesMap outside a subject map or an object map\n" }
  WHERE { ?x rmlc:quotedTriplesMap ?anon15 .
          FILTER NOT EXISTS { ?anon16 (rmlc:subjectMap|rmlc:objectMap) ?x } } LIMIT 1 .

  # RML-LV: cycles, name collisions, references to keys that a logical view
  # does not have (iterators/viewKeys.rqg)
  TEMPLATE { "#ERROR: a logical view or a field depends on itself\n" }
  WHERE { { ?v (rmlc:viewOn|(rmlc:leftJoin|rmlc:innerJoin)/rmlc:parentLogicalView)+ ?v } UNION { ?f rmlc:field+ ?f } } LIMIT 1 .

  TEMPLATE { "#ERROR: a logical view has two fields named \"" ?k "\"\n" }
  WHERE {
    { SELECT ?v ?k WHERE {
        { ?v rmlc:field ?f . ?f rmlc:fieldName ?n1 . BIND(STR(?n1) AS ?k) }
        UNION { ?v rmlc:field ?f1 . ?f1 rmlc:field ?f . ?f1 rmlc:fieldName ?n1 . ?f rmlc:fieldName ?n2 .
                BIND(CONCAT(STR(?n1), ".", STR(?n2)) AS ?k) }
        UNION { ?v (rmlc:leftJoin|rmlc:innerJoin)/rmlc:field ?f . ?f rmlc:fieldName ?n1 . BIND(STR(?n1) AS ?k) }
      } GROUP BY ?v ?k HAVING (COUNT(DISTINCT ?f) > 1) }
  } .

  TEMPLATE {
    TEMPLATE { "#ERROR: logical view " ?vText " has no referenceable key \"" ?r "\"\n" }
    ITERATOR <iterators/viewKeys.rqg>(?v) AS ?keys
    ITERATOR <iterators/references.rqg>("tm", ?tm, <urn:x-rml2sg:none>, <urn:x-rml2sg:none>) AS ?r
    WHERE { FILTER(!CONTAINS(?keys, CONCAT("|", ?r, "|"))) } .
  }
  WHERE {
    ?tm rmlc:logicalSource ?v . ?v rmlc:viewOn ?anon14 .
    FILTER NOT EXISTS { ?v (rmlc:viewOn|(rmlc:leftJoin|rmlc:innerJoin)/rmlc:parentLogicalView)+ ?v }
    BIND(IF(isIRI(?v), STR(?v), "[]") AS ?vText)
  } .

  # RML-FNML: unknown functions, parameters and outputs (iterators/functions.rqg)
  TEMPLATE {
    TEMPLATE { "#ERROR: unknown function <" STR(?f) ">\n" }
    ITERATOR <iterators/functions.rqg>(?f) AS ?pattern ?params ?outputs ?known
    WHERE { FILTER(!?known) } .
    TEMPLATE { "#ERROR: function <" STR(?f) "> has no parameter " ?badParam "\n" }
    ITERATOR <iterators/functions.rqg>(?f) AS ?pattern ?params ?outputs ?known
    WHERE {
      FILTER(?known)
      ?fe rmlc:input/(rmlc:parameter|rmlc:parameterMap/rmlc:constant) ?param .
      BIND(REPLACE(STR(?param), "^.*[#/]", "") AS ?local0)
      BIND(IF(?local0 = "valueParameter", "valueParam", IF(?local0 = "valueParameter2", "valueParam2",
           IF(?local0 = "p_string_find", "param_find", IF(?local0 = "p_string_replace", "param_replace",
           IF(?local0 = "modeParameter", "modeParam", ?local0))))) AS ?badParam)
      FILTER(!CONTAINS(CONCAT(" ", ?params, " "), CONCAT(" ", ?badParam, " ")))
    } .
    TEMPLATE { "#ERROR: function <" STR(?f) "> has no output " ?badOut "\n" }
    ITERATOR <iterators/functions.rqg>(?f) AS ?pattern ?params ?outputs ?known
    WHERE {
      FILTER(?known)
      ?em rmlc:functionExecution ?fe .
      ?em (rmlc:return|rmlc:returnMap/rmlc:constant) ?out .
      BIND(REPLACE(STR(?out), "^.*[#/]", "") AS ?badOut)
      FILTER(!CONTAINS(CONCAT(" ", ?outputs, " "), CONCAT(" ", ?badOut, " ")))
    } .
  }
  WHERE { ?fe (rmlc:function|rmlc:functionMap/rmlc:constant) ?f } .

  TEMPLATE { "#ERROR: triples map " ?tmText " has no logical source, and a term map that is not constant\n" }
  WHERE {
    ?tm (rr:subjectMap|rmlc:subjectMap|rr:subject|rmlc:subject) ?anon10 .
    FILTER NOT EXISTS { ?tm (rml:logicalSource|rmlc:logicalSource|rr:logicalTable) ?anon11 }
    FILTER EXISTS {
      ?tm ((rr:subjectMap|rmlc:subjectMap)|(rr:predicateObjectMap|rmlc:predicateObjectMap)/(rr:predicateMap|rmlc:predicateMap|rr:objectMap|rmlc:objectMap|rr:graphMap|rmlc:graphMap))/(rmlc:functionExecution/rmlc:input/rmlc:inputValueMap|rmlc:condition|rmlc:languageMap|rmlc:datatypeMap)*/(rr:template|rmlc:template|rml:reference|rmlc:reference|rr:column) ?anon12 }
    BIND(IF(isIRI(?tm), STR(?tm), "[]") AS ?tmText)
  } .

  TEMPLATE { "#ERROR: logical table (R2RML) instead of a logical source\n" }
  WHERE { ?anon7 rr:logicalTable ?anon8 } LIMIT 1 .
}
WHERE { }
