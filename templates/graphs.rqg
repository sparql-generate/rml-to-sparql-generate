# The template text that puts the triple patterns ?triples (a string, such as
# "?s ?p ?o .") in the target graphs of subject map ?sm and predicate-object
# map ?pom (<urn:x-rml2sg:none> for the classes, which go to the graphs of the
# subject map only), generated by predicate map ?pt and object map ?ot
# (<urn:x-rml2sg:none> if none):
#
#   ?triples                          the default graph: neither ?sm nor ?pom has
#                                     a graph map, or one of them is rr:defaultGraph
#   GRAPH <g> { ?triples }            a constant graph map (rr:graph <g>,
#                                     rr:graphMap [ rr:constant <g> ])
#   GRAPH ?g_<prefix><h> { ?triples } a graph map with an expression, ?mode = "var":
#                                     its term is bound by the caller, once per
#                                     iteration (CSV, iterators/graphMaps.rqg), as
#                                     the term map in role g_<prefix><h>
#   GENERATE { GRAPH ?g { ?triples } } <iterators> WHERE { <term map> } .
#                                     ?mode = "nested" (JSONPath, XPath): a
#                                     sub-query over the current iteration ?it,
#                                     one quad per value of the graph map; a
#                                     graph map without value generates nothing,
#                                     and the other graphs keep their triples
#
# A graph term that cannot be built (missing value, invalid IRI) leaves its
# variable unbound, and the engine generates no quad in that graph. The graph
# term is an IRI (default term type of a graph map); templates/checks.rqg
# rejects a graph map of another term type.
#
# (GROUP BY: one clause per graph; the variables of the caller are grouped
# by too, or they would be lost.)
#
# Logical targets (RML-IO): a triple whose subject map, predicate map, object
# map, or language or datatype map of the object map, has rml:logicalTarget,
# goes to the file of each target instead of the output, in each of its
# graphs; a graph map with rml:logicalTarget sends the quads of its graph to
# the file of its targets too. The file of a target is a named graph whose IRI
# is its path (rml:target [ rml:path "dump.nq" ]), relative to the base, and a
# graph g inside the file is <path#g=ENCODE_FOR_URI(g)>: SPARQL-Generate 2.6
# writes them to files with --graphs-to-files (format, compression and
# encoding: rml2targets.rqg). A triple with targets is not written to the
# output.
#
#   GRAPH <path> { ?triples }                  the default graph, in the file
#   GRAPH <path#g=<encoded g>> { ?triples }    a constant graph map
#   GRAPH <path#g={STR(?g_...)}> { ?triples }  a graph map with an expression
#
# A graph map is a node of rr:graphMap (rmlc:graphMap); the shortcut rr:graph
# (rmlc:graph) gives a constant. A constant that is not an IRI (rr:graph [ ... ],
# a blank node) names no graph: the triple is not generated in it (a literal is
# an error, templates/checks.rqg).
PREFIX rr:   <http://www.w3.org/ns/r2rml#>
PREFIX rml:  <http://semweb.mmlab.be/ns/rml#>
PREFIX rmlc: <http://w3id.org/rml/>
PREFIX afn:  <http://jena.apache.org/ARQ/function#>

TEMPLATE <templates/graphs.rqg>(?sm, ?pom, ?pt, ?ot, ?triples, ?mode, ?prefix, ?rf, ?dialect, ?base) {

  # the default graph
  TEMPLATE { ?triples " " }
  WHERE {
    FILTER((NOT EXISTS { ?sm (rr:graphMap|rmlc:graphMap|rr:graph|rmlc:graph) ?g1 }
            && NOT EXISTS { ?pom (rr:graphMap|rmlc:graphMap|rr:graph|rmlc:graph) ?g2 })
        || EXISTS { ?sm ((rr:graphMap|rmlc:graphMap)/(rr:constant|rmlc:constant)|rr:graph|rmlc:graph) ?dg1
                    FILTER(?dg1 IN (rr:defaultGraph, rmlc:defaultGraph)) }
        || EXISTS { ?pom ((rr:graphMap|rmlc:graphMap)/(rr:constant|rmlc:constant)|rr:graph|rmlc:graph) ?dg2
                    FILTER(?dg2 IN (rr:defaultGraph, rmlc:defaultGraph)) })
    FILTER NOT EXISTS { { ?sm rmlc:logicalTarget ?lt } UNION { ?pt rmlc:logicalTarget ?lt } UNION { ?ot rmlc:logicalTarget ?lt }
           UNION { ?ot (rmlc:languageMap|rmlc:datatypeMap)/rmlc:logicalTarget ?lt } ?lt rmlc:target/rmlc:path ?ltp0 }
  } .
  # the default graph, in the files of the logical targets
  TEMPLATE { "GRAPH <" ?file "> \{ " ?triples " } " }
  WHERE {
    FILTER((NOT EXISTS { ?sm (rr:graphMap|rmlc:graphMap|rr:graph|rmlc:graph) ?g1 }
            && NOT EXISTS { ?pom (rr:graphMap|rmlc:graphMap|rr:graph|rmlc:graph) ?g2 })
        || EXISTS { ?sm ((rr:graphMap|rmlc:graphMap)/(rr:constant|rmlc:constant)|rr:graph|rmlc:graph) ?dg1
                    FILTER(?dg1 IN (rr:defaultGraph, rmlc:defaultGraph)) }
        || EXISTS { ?pom ((rr:graphMap|rmlc:graphMap)/(rr:constant|rmlc:constant)|rr:graph|rmlc:graph) ?dg2
                    FILTER(?dg2 IN (rr:defaultGraph, rmlc:defaultGraph)) })
    { ?sm rmlc:logicalTarget ?lt } UNION { ?pt rmlc:logicalTarget ?lt } UNION { ?ot rmlc:logicalTarget ?lt }
           UNION { ?ot (rmlc:languageMap|rmlc:datatypeMap)/rmlc:logicalTarget ?lt }
    ?lt rmlc:target/rmlc:path ?ltp .
    BIND(REPLACE(REPLACE(STR(?ltp), "^(\\./)+", ""), " ", "%20") AS ?file)
  } GROUP BY ?file ?triples .

  # constant named graphs
  TEMPLATE { "GRAPH <" STR(?gc) "> \{ " ?triples " } " }
  WHERE {
    { ?sm (rr:graphMap|rmlc:graphMap) ?gm . ?gm (rr:constant|rmlc:constant) ?gc }
    UNION { ?pom (rr:graphMap|rmlc:graphMap) ?gm . ?gm (rr:constant|rmlc:constant) ?gc }
    UNION { ?sm (rr:graph|rmlc:graph) ?gc BIND(<urn:x-rml2sg:none> AS ?gm) }
    UNION { ?pom (rr:graph|rmlc:graph) ?gc BIND(<urn:x-rml2sg:none> AS ?gm) }
    FILTER(isIRI(?gc) && !(?gc IN (rr:defaultGraph, rmlc:defaultGraph)))
    FILTER NOT EXISTS { { ?sm rmlc:logicalTarget ?lt } UNION { ?pt rmlc:logicalTarget ?lt } UNION { ?ot rmlc:logicalTarget ?lt }
           UNION { ?ot (rmlc:languageMap|rmlc:datatypeMap)/rmlc:logicalTarget ?lt } UNION { ?gm rmlc:logicalTarget ?lt } ?lt rmlc:target/rmlc:path ?ltp0 }
  } GROUP BY ?gc ?triples .
  # constant named graphs, in the files of the logical targets
  TEMPLATE { "GRAPH <" ?file "#g=" ENCODE_FOR_URI(STR(?gc)) "> \{ " ?triples " } " }
  WHERE {
    { ?sm (rr:graphMap|rmlc:graphMap) ?gm . ?gm (rr:constant|rmlc:constant) ?gc }
    UNION { ?pom (rr:graphMap|rmlc:graphMap) ?gm . ?gm (rr:constant|rmlc:constant) ?gc }
    UNION { ?sm (rr:graph|rmlc:graph) ?gc BIND(<urn:x-rml2sg:none> AS ?gm) }
    UNION { ?pom (rr:graph|rmlc:graph) ?gc BIND(<urn:x-rml2sg:none> AS ?gm) }
    FILTER(isIRI(?gc) && !(?gc IN (rr:defaultGraph, rmlc:defaultGraph)))
    { ?sm rmlc:logicalTarget ?lt } UNION { ?pt rmlc:logicalTarget ?lt } UNION { ?ot rmlc:logicalTarget ?lt }
           UNION { ?ot (rmlc:languageMap|rmlc:datatypeMap)/rmlc:logicalTarget ?lt } UNION { ?gm rmlc:logicalTarget ?lt }
    ?lt rmlc:target/rmlc:path ?ltp .
    BIND(REPLACE(REPLACE(STR(?ltp), "^(\\./)+", ""), " ", "%20") AS ?file)
  } GROUP BY ?file ?gc ?triples .

  # graph maps with an expression, bound by the caller
  TEMPLATE { "GRAPH ?g_" ?prefix ?h " \{ " ?triples " } " }
  WHERE {
    FILTER(?mode = "var")
    { ?sm (rr:graphMap|rmlc:graphMap) ?gm } UNION { ?pom (rr:graphMap|rmlc:graphMap) ?gm }
    FILTER EXISTS { ?gm (rr:template|rmlc:template|rml:reference|rmlc:reference|rr:column|rmlc:functionExecution) ?e }
    FILTER NOT EXISTS { { ?sm rmlc:logicalTarget ?lt } UNION { ?pt rmlc:logicalTarget ?lt } UNION { ?ot rmlc:logicalTarget ?lt }
           UNION { ?ot (rmlc:languageMap|rmlc:datatypeMap)/rmlc:logicalTarget ?lt } UNION { ?gm rmlc:logicalTarget ?lt } ?lt rmlc:target/rmlc:path ?ltp0 }
    BIND(MD5(IF(isBlank(?gm), afn:bnode(?gm), STR(?gm))) AS ?h)
  } GROUP BY ?h ?triples ?prefix .
  # the same, in the files of the logical targets
  TEMPLATE { "GRAPH <" ?file "#g=\{STR(?g_" ?prefix ?h ")}> \{ " ?triples " } " }
  WHERE {
    FILTER(?mode = "var")
    { ?sm (rr:graphMap|rmlc:graphMap) ?gm } UNION { ?pom (rr:graphMap|rmlc:graphMap) ?gm }
    FILTER EXISTS { ?gm (rr:template|rmlc:template|rml:reference|rmlc:reference|rr:column|rmlc:functionExecution) ?e }
    { ?sm rmlc:logicalTarget ?lt } UNION { ?pt rmlc:logicalTarget ?lt } UNION { ?ot rmlc:logicalTarget ?lt }
           UNION { ?ot (rmlc:languageMap|rmlc:datatypeMap)/rmlc:logicalTarget ?lt } UNION { ?gm rmlc:logicalTarget ?lt }
    ?lt rmlc:target/rmlc:path ?ltp .
    BIND(REPLACE(REPLACE(STR(?ltp), "^(\\./)+", ""), " ", "%20") AS ?file)
    BIND(MD5(IF(isBlank(?gm), afn:bnode(?gm), STR(?gm))) AS ?h)
  } GROUP BY ?file ?h ?triples ?prefix .

  # graph maps with an expression, in a sub-query over the iteration
  TEMPLATE {
    "GENERATE \{ GRAPH ?g \{ " ?triples " } } "
    TEMPLATE <templates/referenceIterators.rqg>(?gm, "", "g", ?rf, ?dialect) .
    "WHERE \{ "
    TEMPLATE <templates/termMap.rqg>(?gm, <urn:x-rml2sg:none>, "", "g", "graph", ?rf, ?dialect, ?base) .
    "} . "
  }
  WHERE {
    FILTER(?mode = "nested")
    { ?sm (rr:graphMap|rmlc:graphMap) ?gm } UNION { ?pom (rr:graphMap|rmlc:graphMap) ?gm }
    FILTER EXISTS { ?gm (rr:template|rmlc:template|rml:reference|rmlc:reference|rr:column|rmlc:functionExecution) ?e }
    FILTER NOT EXISTS { { ?sm rmlc:logicalTarget ?lt } UNION { ?pt rmlc:logicalTarget ?lt } UNION { ?ot rmlc:logicalTarget ?lt }
           UNION { ?ot (rmlc:languageMap|rmlc:datatypeMap)/rmlc:logicalTarget ?lt } UNION { ?gm rmlc:logicalTarget ?lt } ?lt rmlc:target/rmlc:path ?ltp0 }
  } GROUP BY ?gm ?triples ?rf ?dialect ?base .
  # the same, in the files of the logical targets: one sub-query per file
  TEMPLATE {
    "GENERATE \{ GRAPH <" ?file "#g=\{STR(?g)}> \{ " ?triples " } } "
    TEMPLATE <templates/referenceIterators.rqg>(?gm, "", "g", ?rf, ?dialect) .
    "WHERE \{ "
    TEMPLATE <templates/termMap.rqg>(?gm, <urn:x-rml2sg:none>, "", "g", "graph", ?rf, ?dialect, ?base) .
    "} . "
  }
  WHERE {
    FILTER(?mode = "nested")
    { ?sm (rr:graphMap|rmlc:graphMap) ?gm } UNION { ?pom (rr:graphMap|rmlc:graphMap) ?gm }
    FILTER EXISTS { ?gm (rr:template|rmlc:template|rml:reference|rmlc:reference|rr:column|rmlc:functionExecution) ?e }
    { ?sm rmlc:logicalTarget ?lt } UNION { ?pt rmlc:logicalTarget ?lt } UNION { ?ot rmlc:logicalTarget ?lt }
           UNION { ?ot (rmlc:languageMap|rmlc:datatypeMap)/rmlc:logicalTarget ?lt } UNION { ?gm rmlc:logicalTarget ?lt }
    ?lt rmlc:target/rmlc:path ?ltp .
    BIND(REPLACE(REPLACE(STR(?ltp), "^(\\./)+", ""), " ", "%20") AS ?file)
  } GROUP BY ?gm ?file ?triples ?rf ?dialect ?base .
}
WHERE { }
