# The joins of logical view ?view (RML-LV: rml:leftJoin, rml:innerJoin), in the
# iteration of a triples map over ?view (templates/iteration.rqg,
# templates/triplesMap.rqg):
#
#   ?part = "graphs"    FROM GENERATE { ... }: per join J, a record per
#                       iteration of the parent view (templates/viewIteration.rqg,
#                       prefix ?p_): its keys (the parent side of each join
#                       condition), and the value and index of each field of J
#   ?part = "patterns"  in the WHERE clause: the child side of each join
#                       condition bound on the row, then the records of the
#                       parent with that key, looked up in the graph by the
#                       bound key (OPTIONAL for a left join), which bind the
#                       fields of J as keys of ?view (?c_<md5(name)>,
#                       ?c_<md5(name.#)>), each OPTIONAL: a null field of the
#                       parent leaves its key unbound
#
# The graph of the parent records is generated once; each row of the child looks
# its key up in it, so a join costs the rows of the child and the matches, not
# their product (a pattern with a free key, filtered by equality, would scan the
# parent records for every row). Several join conditions make one composite key
# (iterators/joinKeys.rqg, templates/compositeKey.rqg: <lvk_J_keys>), looked up
# at once, not one condition after the other (a scan of the parent records
# with the same value of the first condition). Keys are compared as
# strings; a child key
# without value is an IRI, which no key equals, so it joins nothing (a left
# join keeps the row, its fields unbound; an inner join drops it); a parent
# key without value generates no key triple.
PREFIX rmlc: <http://w3id.org/rml/>
PREFIX afn:  <http://jena.apache.org/ARQ/function#>

TEMPLATE <templates/viewJoins.rqg>(?view, ?part) {
  TEMPLATE {
    "FROM GENERATE \{\n"
    TEMPLATE {
      "    GENERATE \{"
      TEMPLATE { " ?r <urn:x-rml2sg:lvk_" ?J "_" ?h "> ?k" ?h " ." }
      ITERATOR <iterators/joinKeys.rqg>(?j) AS ?h .
      TEMPLATE { " ?r <urn:x-rml2sg:lvf_" ?J "_" ?hv "> ?f" ?hv " ; <urn:x-rml2sg:lvi_" ?J "_" ?hv "> ?i" ?hv " ." }
      WHERE { ?j rmlc:field ?jf . ?jf rmlc:fieldName ?n . BIND(MD5(STR(?n)) AS ?hv) } .
      " }\n    "
      TEMPLATE <templates/viewIteration.rqg>(?pv, "p_", 0) .
      "WHERE \{ "
      TEMPLATE { "BIND(STR(" TEMPLATE <templates/viewExpr.rqg>(?pt, ?pr, "p_") . ") AS ?k" ?h ") " }
      ITERATOR <iterators/joinConditions.rqg>(?j) AS ?h ?ct ?cr ?pt ?pr .
      TEMPLATE <templates/compositeKey.rqg>(?j, "k") .
      TEMPLATE {
        "BIND(" TEMPLATE <templates/viewExpr.rqg>(?jf, "", "p_") . " AS ?f" ?hv ") "
        "BIND(" ?indexText " AS ?i" ?hv ") "
      } WHERE {
        ?j rmlc:field ?jf . ?jf rmlc:fieldName ?n . BIND(MD5(STR(?n)) AS ?hv)
        OPTIONAL { ?jf rmlc:reference ?jr }
        BIND(IF(BOUND(?jr), CONCAT("IF(BOUND(?f", ?hv, "), COALESCE(?p_", MD5(CONCAT(STR(?jr), ".#")), ", 0), ?none)"), "0") AS ?indexText)
      } .
      "BIND(BNODE() AS ?r) } .\n"
    }
    WHERE {
      ?view (rmlc:leftJoin|rmlc:innerJoin) ?j .
      ?j rmlc:parentLogicalView ?pv .
      BIND(MD5(IF(isBlank(?j), afn:bnode(?j), STR(?j))) AS ?J)
    } .
    "  } .\n  "
  } WHERE { FILTER(?part = "graphs" && EXISTS { ?view (rmlc:leftJoin|rmlc:innerJoin) ?anyj }) } .

  TEMPLATE {
    # one condition: its key; several: their values, then the composite key
    TEMPLATE {
      TEMPLATE { "\n  BIND(COALESCE(STR(" TEMPLATE <templates/viewExpr.rqg>(?ct, ?cr, "c_") . "), <urn:x-rml2sg:none>) AS ?lvk" ?J "_" ?h ")" }
      ITERATOR <iterators/joinConditions.rqg>(?j) AS ?h ?ct ?cr ?pt ?pr
      WHERE { FILTER(?kh != "keys") } .
      TEMPLATE { "\n  BIND(STR(" TEMPLATE <templates/viewExpr.rqg>(?ct, ?cr, "c_") . ") AS ?lvc" ?J "_" ?h ")" }
      ITERATOR <iterators/joinConditions.rqg>(?j) AS ?h ?ct ?cr ?pt ?pr
      WHERE { FILTER(?kh = "keys") } .
      TEMPLATE {
        "\n  " TEMPLATE <templates/compositeKey.rqg>(?j, CONCAT("lvc", ?J, "_")) .
        "BIND(COALESCE(?lvc" ?J "_keys, <urn:x-rml2sg:none>) AS ?lvk" ?J "_keys)"
      } WHERE { FILTER(?kh = "keys") } .
    }
    ITERATOR <iterators/joinKeys.rqg>(?j) AS ?kh .
    "\n  " ?open
    TEMPLATE { " ?lvr" ?J " <urn:x-rml2sg:lvk_" ?J "_" ?h "> ?lvk" ?J "_" ?h " ." }
    ITERATOR <iterators/joinKeys.rqg>(?j) AS ?h .
    TEMPLATE { " OPTIONAL \{ ?lvr" ?J " <urn:x-rml2sg:lvf_" ?J "_" ?hv "> ?c_" ?hv " } OPTIONAL \{ ?lvr" ?J " <urn:x-rml2sg:lvi_" ?J "_" ?hv "> ?c_" ?hi " }" }
    WHERE { ?j rmlc:field ?jf . ?jf rmlc:fieldName ?n . BIND(MD5(STR(?n)) AS ?hv) BIND(MD5(CONCAT(STR(?n), ".#")) AS ?hi) } .
    ?close
  }
  WHERE {
    FILTER(?part = "patterns")
    ?view ?kind ?j .
    FILTER(?kind IN (rmlc:leftJoin, rmlc:innerJoin))
    BIND(MD5(IF(isBlank(?j), afn:bnode(?j), STR(?j))) AS ?J)
    # an inner join: the patterns and filters in the WHERE clause itself
    BIND(IF(?kind = rmlc:leftJoin, "OPTIONAL \{", "") AS ?open)
    BIND(IF(?kind = rmlc:leftJoin, " }", "") AS ?close)
  } .
}
WHERE { }
