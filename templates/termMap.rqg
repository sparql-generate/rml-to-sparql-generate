# E_t: the BIND clauses that bind ?<role> to the RDF term of a term map, in
# the WHERE clause of a generated sub-query.
#
#   ?t      the term map (a node of the mapping), or <urn:x-rml2sg:none>
#   ?const  a constant given by a shortcut (rr:subject, rr:predicate, ...), or
#           <urn:x-rml2sg:none>
#   ?ref    a reference given as a string (rr:child, rr:parent), or ""
#   ?role   the variable bound: s, p, o, k<n> (join key), ...
#   ?kind   "subject" | "predicate" | "object" | "graph" | "key" | "language"
#           | "datatype": gives the default term type, and for "key" and
#           "language" a plain string is wanted, not a term
#   ?rf     "CSV" | "JSONPath" | "XPath"; ?dialect "rml" (RML 1.x, rr:/rml:)
#           or "rmlc" (RML-Core, http://w3id.org/rml/); ?base the base IRI
#
# A reference r is read from the variable ?c_<md5(r)> (CSV, bound by the
# iteration over the rows) or ?<role>_<md5(r)> (JSONPath, XPath: bound by the
# iterators of templates/referenceIterators.rqg). The lexical form is bound
# first to ?l_<role>, then the term. A term that cannot be built (invalid
# IRI, missing value) leaves ?<role> unbound, and the triple is not generated.
PREFIX rr:   <http://www.w3.org/ns/r2rml#>
PREFIX rml:  <http://semweb.mmlab.be/ns/rml#>
PREFIX rmlc: <http://w3id.org/rml/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX afn:  <http://jena.apache.org/ARQ/function#>

TEMPLATE <templates/termMap.rqg>(?t, ?const, ?ref, ?role, ?kind, ?rf, ?dialect, ?base) {

  # constant-valued
  TEMPLATE { "BIND(" ?constText " AS ?" ?role ") " }
  WHERE { FILTER(BOUND(?c)) } .

  # lexical form of a reference-valued term map
  TEMPLATE { "BIND(" ?lexical " AS ?l_" ?role ") " }
  WHERE {
    FILTER(BOUND(?r))
    # the columns of a parent iterated inside its child's iteration (roles
    # j...: templates/joinInIteration.rqg) are ?jc_, apart from the child's ?c_
    BIND(IF(?rf = "CSV", IF(STRSTARTS(?role, "j"), "?jc_", "?c_"), CONCAT("?", ?role, "_")) AS ?prefix)
    BIND(CONCAT(?prefix, MD5(?r)) AS ?var)
    # RML-Core keeps the natural datatype of the value (JSON numbers, booleans)
    # for a literal without language or datatype; RML 1.x reads strings
    BIND(IF(?dialect = "rmlc" && ?tt = "Literal" && !BOUND(?lang) && !BOUND(?lm)
            && !BOUND(?dt) && !BOUND(?dm) && ?kind = "object",
            ?var, CONCAT("STR(", ?var, ")")) AS ?lexical)
  } .

  # lexical form of a template-valued term map
  TEMPLATE { "BIND(" TEMPLATE <templates/text.rqg>(?tpl, ?enc, ?role, ?rf) . " AS ?l_" ?role ") " }
  WHERE {
    FILTER(BOUND(?tpl) && !BOUND(?c))
    BIND(IF(?tt = "IRI", "iri", IF(?tt = "URI", "uri", "none")) AS ?enc)
  } .

  # language and datatype maps (RML-Core): their own terms, bound first
  TEMPLATE <templates/termMap.rqg>(?lm, <urn:x-rml2sg:none>, "", CONCAT(?role, "lang"), "language", ?rf, ?dialect, ?base)
  WHERE { FILTER(BOUND(?lm)) } .
  TEMPLATE <templates/termMap.rqg>(?dm, <urn:x-rml2sg:none>, "", CONCAT(?role, "dt"), "datatype", ?rf, ?dialect, ?base)
  WHERE { FILTER(BOUND(?dm)) } .

  # the term, from the lexical form
  TEMPLATE { "BIND(" ?term " AS ?" ?role ") " }
  WHERE {
    FILTER(!BOUND(?c) && (BOUND(?r) || BOUND(?tpl)))
    BIND(CONCAT("?l_", ?role) AS ?l)
    BIND(CONCAT("STR(", ?l, ")") AS ?sl)
    BIND(CONCAT("\"", REPLACE(REPLACE(?base, "\\\\", "\\\\\\\\"), "\"", "\\\\\""), "\"") AS ?baseText)
    BIND(
      IF(?kind = "key" || ?kind = "language", ?sl,
      # R2 of τ': a template whose constant text starts with a scheme gives
      # an absolute IRI whatever the values: no test at run time
      IF((?tt = "IRI" || ?tt = "URI" || ?tt = "UnsafeIRI") && BOUND(?tpl)
         && REGEX(?tpl, "^[A-Za-z][A-Za-z0-9+.-]*:"),
         CONCAT("IRI(", ?sl, ")"),
      IF(?tt = "IRI" || ?tt = "URI" || ?tt = "UnsafeIRI",
         CONCAT("IRI(IF(REGEX(", ?sl, ", \"^[A-Za-z][A-Za-z0-9+.-]*:\"), ", ?sl, ", CONCAT(", ?baseText, ", ", ?sl, ")))"),
      IF(?tt = "BlankNode", CONCAT("fun:bnode(", ?sl, ")"),
      IF(BOUND(?lang), CONCAT("STRLANG(", ?sl, ", \"", STR(?lang), "\")"),
      IF(BOUND(?lm), CONCAT("STRLANG(", ?sl, ", ?", ?role, "lang)"),
      IF(BOUND(?dt), CONCAT("STRDT(", ?sl, ", <", STR(?dt), ">)"),
      IF(BOUND(?dm), CONCAT("STRDT(", ?sl, ", ?", ?role, "dt)"),
      ?l)))))))) AS ?term)
  } .

  # a blank node without expression: one per iteration, bound by the
  # enclosing triples-map query (templates/triplesMap.rqg)
  # one blank node per iteration and role: ?bn_s, ?bn_o (also for o_<key>)
  TEMPLATE { "BIND(?bn_" SUBSTR(?role, 1, 1) " AS ?" ?role ") " }
  WHERE { FILTER(!BOUND(?c) && !BOUND(?r) && !BOUND(?tpl) && ?tt = "BlankNode") } .
}
WHERE {
  OPTIONAL { ?t (rr:constant|rmlc:constant) ?c0 }
  BIND(IF(?const != <urn:x-rml2sg:none>, ?const, ?c0) AS ?c)
  OPTIONAL { ?t (rml:reference|rmlc:reference|rr:column) ?r0 }
  BIND(COALESCE(STR(?r0), IF(?ref != "", ?ref, ?none)) AS ?r)
  OPTIONAL { ?t (rr:template|rmlc:template) ?tpl0 }
  BIND(STR(?tpl0) AS ?tpl)
  OPTIONAL { ?t (rr:termType|rmlc:termType) ?tt0 }
  OPTIONAL { ?t (rr:language|rmlc:language) ?lang }
  OPTIONAL { ?t rmlc:languageMap ?lm }
  OPTIONAL { ?t (rr:datatype|rmlc:datatype) ?dt }
  OPTIONAL { ?t rmlc:datatypeMap ?dm }
  # term type: explicit, or the default of RML ("Default term types")
  BIND(COALESCE(REPLACE(STR(?tt0), "^.*[#/]", ""),
       IF(?kind = "object" && (BOUND(?r) || BOUND(?lang) || BOUND(?lm) || BOUND(?dt) || BOUND(?dm)),
          "Literal",
       IF(?kind = "key" || ?kind = "language", "Literal", "IRI"))) AS ?tt)
  # the text of a constant: an IRI, a literal, or (as a string) a key
  BIND(IF(?kind = "key" || ?kind = "language", CONCAT("\"", REPLACE(REPLACE(STR(?c), "\\\\", "\\\\\\\\"), "\"", "\\\\\""), "\""),
       IF(isIRI(?c), CONCAT("<", STR(?c), ">"),
       IF(isLiteral(?c),
          CONCAT("\"", REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(STR(?c), "\\\\", "\\\\\\\\"), "\"", "\\\\\""), "\n", "\\\\n"), "\r", "\\\\r"), "\\\{", "\\\\\{"), "\"",
                 IF(LANG(?c) != "", CONCAT("@", LANG(?c)),
                 IF(DATATYPE(?c) != xsd:string, CONCAT("^^<", STR(DATATYPE(?c)), ">"), ""))),
       "fun:bnode(\"urn:x-rml2sg:constant-blank-node\")")))
       AS ?constText)
}
