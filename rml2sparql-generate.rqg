# rml2sparql-generate: translates an RML mapping into an equivalent
# SPARQL-Generate query. It is itself a SPARQL-Generate query (a TEMPLATE):
# the mapping is its default graph, the generated query is its text output.
#
#   java -jar sparql-generate.jar -d <dir> -q rml2sparql-generate.rqg \
#        -b <base IRI> -o generated.rqg
#
# with the mapping in <dir>/dataset/default.ttl and this repository's
# templates/ and iterators/ in <dir>. The base IRI (-b) resolves the relative
# IRIs that the mapping generates, and names the sources of the generated
# query: run it with the same -b from the directory of the data.
#
# Both RML 1.x (rr:, rml:, ql:) and RML-Core (http://w3id.org/rml/) mappings
# are read; see README.md for what the translation covers.
PREFIX rr:   <http://www.w3.org/ns/r2rml#>
PREFIX rml:  <http://semweb.mmlab.be/ns/rml#>
PREFIX rmlc: <http://w3id.org/rml/>
PREFIX formats: <http://www.w3.org/ns/formats/>
PREFIX d2rq: <http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#>

TEMPLATE {
  "# Generated by rml2sparql-generate from an RML mapping\n"
  "# (https://github.com/sparql-generate/rml-to-sparql-generate).\n"
  TEMPLATE <templates/checks.rqg>(?dialect) .
  "BASE <" ?base ">\n"
  "PREFIX iter: <http://w3id.org/sparql-generate/iter/>\n"
  "PREFIX fun: <http://w3id.org/sparql-generate/fn/>\n"
  "\nGENERATE \{\n"

  # data errors of the CSV sources: a reference to a column that the header
  # does not have (templates/columnChecks.rqg)
  TEMPLATE { TEMPLATE <templates/columnChecks.rqg>(?tm, ?rf) . }
  ITERATOR <iterators/tms.rqg>(?base) AS ?tm ?rf ?tmbase ?group .
  # of the JSON and XML sources of RML 1.x: a reference without value in any
  # record (templates/keyChecks.rqg)
  TEMPLATE { TEMPLATE <templates/keyChecks.rqg>(?tm, ?rf) . }
  ITERATOR <iterators/tms.rqg>(?base) AS ?tm ?rf ?tmbase ?group .

  # each triples map alone, or (rewriting R3, README.md) the triples maps of a shared CSV
  # source in one iteration
  TEMPLATE { TEMPLATE <templates/triplesMap.rqg>(?tm, ?rf, ?dialect, ?tmbase, ?base) . }
  ITERATOR <iterators/tms.rqg>(?base) AS ?tm ?rf ?tmbase ?group
  WHERE { FILTER(?group = "") } .

  TEMPLATE { TEMPLATE <templates/csvGroup.rqg>(?group, ?dialect, ?base) . }
  ITERATOR <iterators/groups.rqg>(?base) AS ?group .

  TEMPLATE <templates/join.rqg>(?tm, ?pom, ?pt, ?pc, ?om, ?rf, ?prf, ?dialect, ?tmbase, ?pbase)
  WHERE {
    ?tm (rr:predicateObjectMap|rmlc:predicateObjectMap) ?pom .
    ?pom (rr:objectMap|rmlc:objectMap) ?om .
    ?om (rr:parentTriplesMap|rmlc:parentTriplesMap) ?ptm .
    ?tm (rml:logicalSource|rmlc:logicalSource) ?ls1 .
    ?ptm (rml:logicalSource|rmlc:logicalSource) ?ls2 .
    # not joined in the iteration of the child (a CSV child whose subject is a
    # blank node without expression: templates/joinInIteration.rqg)
    FILTER NOT EXISTS {
      FILTER EXISTS { ?om (rr:joinCondition|rmlc:joinCondition) ?anon5 }
      ?tm (rr:subjectMap|rmlc:subjectMap) ?bs .
      ?bs (rr:termType|rmlc:termType) ?btt . FILTER(?btt IN (rr:BlankNode, rmlc:BlankNode))
      FILTER NOT EXISTS { ?bs (rr:template|rmlc:template|rml:reference|rmlc:reference|rr:column|rr:constant|rmlc:constant) ?bx }
      ?ls1 (rml:referenceFormulation|rmlc:referenceFormulation) ?rfb .
      FILTER(REPLACE(STR(?rfb), "^.*[#/]", "") = "CSV")
    }
    # not joined on the same row, in the iteration of the child (rewriting
    # R8: iterators/poms.rqg)
    FILTER NOT EXISTS { ?om <urn:x-rml2sg:sameRow> true }
    # with a join condition, or over another logical source
    FILTER(EXISTS { ?om (rr:joinCondition|rmlc:joinCondition) ?anon1 } || !(?ls1 = ?ls2 || EXISTS {
          # effectively equal logical sources: same source, reference
          # formulation and iterator
          ?ls1 (rml:referenceFormulation|rmlc:referenceFormulation) ?rfa .
          ?ls2 (rml:referenceFormulation|rmlc:referenceFormulation) ?rfa .
          OPTIONAL { ?ls1 (rml:source|rmlc:source) ?sa FILTER(isLiteral(?sa)) }
          OPTIONAL { ?ls1 (rml:source|rmlc:source)/(rmlc:path|rmlc:file) ?pa }
          OPTIONAL { ?ls2 (rml:source|rmlc:source) ?sb FILTER(isLiteral(?sb)) }
          OPTIONAL { ?ls2 (rml:source|rmlc:source)/(rmlc:path|rmlc:file) ?pb }
          OPTIONAL { ?ls1 (rml:iterator|rmlc:iterator) ?ia }
          OPTIONAL { ?ls2 (rml:iterator|rmlc:iterator) ?ib }
          FILTER(STR(COALESCE(?pa, ?sa, "")) = STR(COALESCE(?pb, ?sb, ""))
                 && STR(COALESCE(?ia, "")) = STR(COALESCE(?ib, "")))
        }))
    { ?pom (rr:predicateMap|rmlc:predicateMap) ?pm0 } UNION { ?pom (rr:predicate|rmlc:predicate) ?pc0 }
    BIND(COALESCE(?pm0, <urn:x-rml2sg:none>) AS ?pt)
    BIND(COALESCE(?pc0, <urn:x-rml2sg:none>) AS ?pc)
    ?ls1 (rml:referenceFormulation|rmlc:referenceFormulation) ?rfi .
    ?ls2 (rml:referenceFormulation|rmlc:referenceFormulation) ?prfi .
    BIND(REPLACE(STR(?rfi), "^.*[#/]", "") AS ?rf)
    BIND(REPLACE(STR(?prfi), "^.*[#/]", "") AS ?prf)
    OPTIONAL { ?tm rmlc:baseIRI ?b }
    BIND(COALESCE(STR(?b), ?base) AS ?tmbase)
    OPTIONAL { ?ptm rmlc:baseIRI ?pb }
    BIND(COALESCE(STR(?pb), ?base) AS ?pbase)
  } .

  # gather maps (RML-CC): the collections and containers, and the triples
  # that refer to them
  TEMPLATE <templates/gather.rqg>(?tm, ?gm, ?pom, ?rf, ?dialect, ?tmbase)
  WHERE {
    { ?tm rmlc:subjectMap ?gm . BIND(<urn:x-rml2sg:none> AS ?pom) }
    UNION { ?tm rmlc:predicateObjectMap ?pom . ?pom rmlc:objectMap ?gm }
    ?gm rmlc:gather ?anyg .
    ?tm rmlc:logicalSource/rmlc:referenceFormulation ?rfi .
    BIND(REPLACE(STR(?rfi), "^.*[#/]", "") AS ?rf)
    FILTER(?rf IN ("CSV", "JSONPath", "XPath"))
    OPTIONAL { ?tm rmlc:baseIRI ?b }
    BIND(COALESCE(STR(?b), ?base) AS ?tmbase)
  } .

  "}\nWHERE \{}\n"
}
# The mapping, read as a graph where two RML-IO reference formulations become
# the ones they behave as (the templates test the local name of the
# formulation): an XPath reference formulation with namespaces (a blank node,
# rml:XPathReferenceFormulation) is rml:XPath, the namespaces of the document
# resolving its prefixes; SPARQL results (formats:SPARQL_Results_CSV, ...) are
# rml:CSV, the logical source marked <urn:x-rml2sg:sparqlResults>: the
# solutions of its iterator, a SELECT query on the source, are the rows
# (iter:SPARQL, templates/iteration.rqg).
#
# A relational source is rml:CSV too, marked <urn:x-rml2sg:sql> (iter:SQL,
# templates/iteration.rqg): a logical source whose source is a D2RQ database
# (d2rq:jdbcDSN, d2rq:username, d2rq:password), and an R2RML logical table
# (rr:logicalTable, read as rml:logicalSource) on the only database of the
# mapping. Its source becomes the JDBC URL of the database, with the user
# and the password (and, for MySQL and a query in SQL:2008, the ANSI_QUOTES
# mode), and its iterator the effective SQL query of R2RML:
# "SELECT * FROM <table>" for rr:tableName or rml:SQL2008Table (the table
# name as written, a SQL identifier: delimited with quotes, or not), the query
# of rml:query, rr:sqlQuery or rml:SQL2008Query. The effective query tells two
# logical sources apart (joins, rewriting R3), as the path of a file does.
FROM GENERATE {
  ?s ?p2 ?o2 .
  ?sparqlLs <urn:x-rml2sg:sparqlResults> true .
  ?sqlLs <urn:x-rml2sg:sql> true .
  ?sqlRfLs rml:referenceFormulation rmlc:CSV .
  ?sqlItLs rml:iterator ?sqlQuery .
  ?sqlSrcLs rml:source ?sqlUrl .
  ?sameRowOm <urn:x-rml2sg:sameRow> true .
} WHERE {
  ?s ?p ?o .
  # rewriting R8 (README.md): a referencing object map ?s whose join is
  # computed in the iteration of the child, on the same row, without key
  # graphs. The child and the parent read the same CSV source; every join
  # condition joins a column c with itself; the child subject map is an IRI
  # template or reference whose references are all c, at least once; the
  # predicate and the graph maps are constants. Then the child subject (and
  # the predicate, the graphs) of a row depends on its value of c only: for a
  # pair of rows (r, r') with the same non-null value of c, the joined triple
  # (s(r), p, o(r')) is (s(r'), p, o(r')), the triple of the pair (r', r');
  # and a row whose c is null has no subject. The join is then the set of
  # (s(r), p, o(r)) over the rows: no uniqueness of c is needed, the output
  # being a set. Each condition below keeps this argument exact.
  OPTIONAL {
    FILTER(?p IN (rr:parentTriplesMap, rmlc:parentTriplesMap))
    FILTER NOT EXISTS { ?s (rr:parentTriplesMap|rmlc:parentTriplesMap) ?ptmX FILTER(?ptmX != ?o) }
    # one predicate-object map of one triples map
    ?jPom (rr:objectMap|rmlc:objectMap) ?s .
    ?jTm (rr:predicateObjectMap|rmlc:predicateObjectMap) ?jPom .
    FILTER NOT EXISTS { ?jPomX (rr:objectMap|rmlc:objectMap) ?s FILTER(?jPomX != ?jPom) }
    FILTER NOT EXISTS { ?jTmX (rr:predicateObjectMap|rmlc:predicateObjectMap) ?jPom FILTER(?jTmX != ?jTm) }
    # the join column: one, joined with itself by every condition, given as
    # a string (rr:child, rr:parent), without \ { } (template syntax)
    ?s (rr:joinCondition|rmlc:joinCondition)/(rr:child|rmlc:child) ?jCol .
    FILTER(!REGEX(STR(?jCol), "[\\\\\{}]"))
    FILTER NOT EXISTS {
      ?s (rr:joinCondition|rmlc:joinCondition) ?jc .
      FILTER(EXISTS { ?jc (rmlc:childMap|rmlc:parentMap) ?jMap }
             || EXISTS { ?jc (rr:child|rmlc:child|rr:parent|rmlc:parent) ?jRef FILTER(STR(?jRef) != STR(?jCol)) }
             || NOT EXISTS { ?jc (rr:child|rmlc:child) ?jc1 } || NOT EXISTS { ?jc (rr:parent|rmlc:parent) ?jp1 })
    }
    # the same CSV source: one logical source each, the same node or the
    # same description (every property and value, the source a literal, an
    # IRI or a blank node described by the same literals and IRIs); not a
    # logical view, nor a database (iter:SQL)
    ?jTm (rml:logicalSource|rmlc:logicalSource) ?jLsC .
    ?o (rml:logicalSource|rmlc:logicalSource) ?jLsP .
    FILTER NOT EXISTS { ?jTm (rml:logicalSource|rmlc:logicalSource) ?jLsX FILTER(?jLsX != ?jLsC) }
    FILTER NOT EXISTS { ?o (rml:logicalSource|rmlc:logicalSource) ?jLsX2 FILTER(?jLsX2 != ?jLsP) }
    ?jLsC (rml:referenceFormulation|rmlc:referenceFormulation) ?jRf .
    FILTER(isIRI(?jRf) && REPLACE(STR(?jRf), "^.*[#/]", "") = "CSV")
    FILTER NOT EXISTS { ?jLsC (rml:referenceFormulation|rmlc:referenceFormulation) ?jRfX FILTER(?jRfX != ?jRf) }
    FILTER NOT EXISTS { ?jLsC rmlc:viewOn ?jView }
    FILTER NOT EXISTS { ?jLsC (rml:source|rmlc:source)/d2rq:jdbcDSN ?jDsn }
    FILTER EXISTS { ?jLsC (rml:source|rmlc:source) ?jSrc }
    FILTER(?jLsC = ?jLsP || (
      NOT EXISTS { ?jLsC ?jq ?jv FILTER(!isBlank(?jv)) FILTER NOT EXISTS { ?jLsP ?jq ?jv } }
      && NOT EXISTS { ?jLsP ?jq2 ?jv2 FILTER(!isBlank(?jv2)) FILTER NOT EXISTS { ?jLsC ?jq2 ?jv2 } }
      && NOT EXISTS { { ?jLsC ?jq3 ?jv3 } UNION { ?jLsP ?jq3 ?jv3 } FILTER(isBlank(?jv3) && ?jq3 NOT IN (rml:source, rmlc:source)) }
      && NOT EXISTS {
        ?jLsC (rml:source|rmlc:source) ?jSa . ?jLsP (rml:source|rmlc:source) ?jSb .
        FILTER(?jSa != ?jSb)
        FILTER(!isBlank(?jSa) || !isBlank(?jSb)
               || EXISTS { { ?jSa ?jq4 ?jv4 } UNION { ?jSb ?jq4 ?jv4 } FILTER(isBlank(?jv4)) }
               || EXISTS { ?jSa ?jq5 ?jv5 FILTER NOT EXISTS { ?jSb ?jq5 ?jv5 } }
               || EXISTS { ?jSb ?jq6 ?jv6 FILTER NOT EXISTS { ?jSa ?jq6 ?jv6 } })
      }))
    # the child subject map: one, an IRI, a template whose references are
    # all the join column (as many references as occurrences of {c}) or the
    # reference c; no function, star map, gather map, target
    ?jTm (rr:subjectMap|rmlc:subjectMap) ?jSm .
    FILTER NOT EXISTS { ?jTm (rr:subjectMap|rmlc:subjectMap|rr:subject|rmlc:subject) ?jSmX FILTER(?jSmX != ?jSm) }
    FILTER NOT EXISTS { ?jSm (rr:termType|rmlc:termType) ?jTt
                        FILTER(?jTt NOT IN (rr:IRI, rmlc:IRI, rmlc:URI, rmlc:UnsafeIRI, rmlc:UnsafeURI)) }
    FILTER NOT EXISTS { ?jSm (rmlc:functionExecution|rmlc:condition|rmlc:quotedTriplesMap|rmlc:gather|rmlc:logicalTarget
                              |rr:constant|rmlc:constant) ?jX }
    FILTER NOT EXISTS { ?jSm (rr:template|rmlc:template|rml:reference|rmlc:reference|rr:column) ?jE1 ,  ?jE2 FILTER(?jE1 != ?jE2) }
    { ?jSm (rr:template|rmlc:template) ?jTpl } UNION { ?jSm (rml:reference|rmlc:reference|rr:column) ?jRefS }
    BIND(STR(?jTpl) AS ?jT)
    BIND(CONCAT("\{", STR(?jCol), "}") AS ?jBraced)
    FILTER(IF(BOUND(?jTpl),
              !CONTAINS(?jT, "\\") && CONTAINS(?jT, ?jBraced)
              && STRLEN(?jT) - STRLEN(REPLACE(?jT, ?jBraced, "", "q"))
                 = (STRLEN(?jT) - STRLEN(REPLACE(?jT, "\{", "", "q"))) * STRLEN(?jBraced),
              STR(?jRefS) = STR(?jCol)))
    # the parent subject map: one, with an expression (not a blank node per
    # iteration), no star map, gather map, target
    ?o (rr:subjectMap|rmlc:subjectMap) ?jPsm .
    FILTER NOT EXISTS { ?o (rr:subjectMap|rmlc:subjectMap|rr:subject|rmlc:subject) ?jPsmX FILTER(?jPsmX != ?jPsm) }
    FILTER EXISTS { ?jPsm (rr:template|rmlc:template|rml:reference|rmlc:reference|rr:column|rr:constant|rmlc:constant|rmlc:functionExecution) ?jPe }
    FILTER NOT EXISTS { ?jPsm (rmlc:quotedTriplesMap|rmlc:gather|rmlc:logicalTarget) ?jPx }
    FILTER NOT EXISTS { ?s (rmlc:logicalTarget|rmlc:quotedTriplesMap|rmlc:gather) ?jOx }
    # the predicates and the graphs: constants
    FILTER NOT EXISTS { ?jPom (rr:predicateMap|rmlc:predicateMap) ?jPm
                        FILTER NOT EXISTS { ?jPm (rr:constant|rmlc:constant) ?jPc } }
    FILTER NOT EXISTS { ?jPom (rr:predicateMap|rmlc:predicateMap) ?jPm2 .
                        ?jPm2 (rmlc:functionExecution|rr:template|rmlc:template|rml:reference|rmlc:reference|rr:column) ?jPv }
    FILTER NOT EXISTS { { ?jPom (rr:graphMap|rmlc:graphMap) ?jGm } UNION { ?jSm (rr:graphMap|rmlc:graphMap) ?jGm }
                        ?jGm (rmlc:functionExecution|rr:template|rmlc:template|rml:reference|rmlc:reference|rr:column) ?jGv }
    BIND(?s AS ?sameRowOm)
  }
  OPTIONAL {
    { ?s (rml:source|rmlc:source) ?db . ?db d2rq:jdbcDSN ?dsn }
    UNION
    { ?anyLt rr:logicalTable ?s .
      FILTER NOT EXISTS { ?s (rml:source|rmlc:source) ?anySrc }
      { SELECT (SAMPLE(?db0) AS ?db) WHERE { ?db0 d2rq:jdbcDSN ?anyDsn } HAVING (COUNT(DISTINCT ?db0) = 1) }
      ?db d2rq:jdbcDSN ?dsn }
    OPTIONAL { ?db d2rq:username ?user }
    OPTIONAL { ?db d2rq:password ?password }
    OPTIONAL { ?s rr:tableName ?table }
    OPTIONAL { ?s (rml:query|rr:sqlQuery) ?query }
    OPTIONAL { ?s (rml:referenceFormulation|rmlc:referenceFormulation) ?sqlRf }
    OPTIONAL { ?s (rml:iterator|rmlc:iterator) ?sqlIt }
    BIND(COALESCE(REPLACE(STR(?sqlRf), "^.*[#/]", ""), "") AS ?sqlRfName)
    BIND(STR(?dsn) AS ?dsnText)
    # the user and the password in the URL, as each driver reads them
    BIND(IF(!BOUND(?user) || REGEX(?dsnText, "[?;&]user=", "i"), ?dsnText,
         IF(STRSTARTS(?dsnText, "jdbc:sqlserver:"),
            CONCAT(?dsnText, ";user=\{", REPLACE(STR(?user), "}", "}}"), "};password=\{", REPLACE(STR(COALESCE(?password, "")), "}", "}}"), "}"),
         IF(STRSTARTS(?dsnText, "jdbc:h2:"),
            CONCAT(?dsnText, ";USER=", STR(?user), ";PASSWORD=", STR(COALESCE(?password, ""))),
            CONCAT(?dsnText, IF(CONTAINS(?dsnText, "?"), "&", "?"), "user=", ENCODE_FOR_URI(STR(?user)),
                   "&password=", ENCODE_FOR_URI(STR(COALESCE(?password, ""))))))) AS ?url0)
    # a query in SQL:2008 (rr:sqlVersion rr:SQL2008, rml:SQL2008Table,
    # rml:SQL2008Query) delimits identifiers with double quotes: MySQL reads
    # them so in its ANSI_QUOTES mode, added to the session's SQL mode
    # (RMLTC0015a-MySQL: SELECT "Code", "Name" FROM "Country")
    BIND(STRSTARTS(?dsnText, "jdbc:mysql:")
         && (EXISTS { ?s rr:sqlVersion rr:SQL2008 } || ?sqlRfName IN ("SQL2008Table", "SQL2008Query"))
         && !REGEX(?dsnText, "[?&]sessionVariables=", "i") AS ?ansiQuotes)
    BIND(IF(?ansiQuotes, CONCAT(?url0, IF(CONTAINS(?url0, "?"), "&", "?"), "sessionVariables=",
            ENCODE_FOR_URI("sql_mode=CONCAT(@@sql_mode,',ANSI_QUOTES')")), ?url0) AS ?url)
    BIND(REPLACE(
           IF(?sqlRfName = "SQL2008Table", CONCAT("SELECT * FROM ", STR(?sqlIt)),
           IF(?sqlRfName = "SQL2008Query", STR(?sqlIt),
           COALESCE(STR(?query), CONCAT("SELECT * FROM ", STR(?table))))),
           "^\\s+|[\\s;]+$", "") AS ?effectiveQuery)
  }
  BIND(BOUND(?url) && BOUND(?effectiveQuery) AS ?sql)
  BIND(IF(?sql, ?s, ?none) AS ?sqlLs)
  BIND(IF(?sql && !BOUND(?sqlRf), ?s, ?none) AS ?sqlRfLs)
  BIND(IF(?sql && !BOUND(?sqlIt), ?s, ?none) AS ?sqlItLs)
  BIND(IF(?sql && NOT EXISTS { ?s (rml:source|rmlc:source) ?anySrc2 }, ?s, ?none) AS ?sqlSrcLs)
  BIND(IF(?sql, ?effectiveQuery, ?none) AS ?sqlQuery)
  BIND(IF(?sql, ?url, ?none) AS ?sqlUrl)
  BIND(IF(?p = rr:logicalTable, rml:logicalSource, ?p) AS ?p2)
  OPTIONAL {
    FILTER(?p IN (rmlc:referenceFormulation, rml:referenceFormulation) && isBlank(?o))
    ?o a rmlc:XPathReferenceFormulation .
    BIND(rmlc:XPath AS ?xpath)
  }
  OPTIONAL {
    FILTER(?p IN (rmlc:referenceFormulation, rml:referenceFormulation)
           && ?o IN (formats:SPARQL_Results_CSV, formats:SPARQL_Results_JSON, formats:SPARQL_Results_XML, formats:SPARQL_Results_TSV))
    BIND(rmlc:CSV AS ?csv)
  }
  BIND(IF(?sql && ?p IN (rml:source, rmlc:source), ?url,
       IF(?sql && ?p IN (rml:referenceFormulation, rmlc:referenceFormulation), rmlc:CSV,
       IF(?sql && ?p IN (rml:iterator, rmlc:iterator), ?effectiveQuery,
       COALESCE(?xpath, ?csv, ?o)))) AS ?o2)
  BIND(IF(BOUND(?csv), ?s, ?none) AS ?sparqlLs)
} .
WHERE {
  # the base IRI is the one given on the command line (-b)
  BIND(STR(IRI("")) AS ?base)
  BIND(IF(EXISTS { ?x rmlc:logicalSource ?y }, "rmlc", "rml") AS ?dialect)
}
