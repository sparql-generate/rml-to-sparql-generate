# rml2sparql-generate: translates an RML mapping into an equivalent
# SPARQL-Generate query. It is itself a SPARQL-Generate query (a TEMPLATE):
# the mapping is its default graph, the generated query is its text output.
#
#   java -jar sparql-generate.jar -d <dir> -q rml2sparql-generate.rqg \
#        -b <base IRI> -o generated.rqg
#
# with the mapping in <dir>/dataset/default.ttl and this repository's
# templates/ and iterators/ in <dir>. The base IRI (-b) resolves the relative
# IRIs that the mapping generates, and names the sources of the generated
# query: run it with the same -b from the directory of the data.
#
# Both RML 1.x (rr:, rml:, ql:) and RML-Core (http://w3id.org/rml/) mappings
# are read. The translation is τ of rml-translation.md (the semantics of
# SPARQL-Generate); see README.md for what it covers.
PREFIX rr:   <http://www.w3.org/ns/r2rml#>
PREFIX rml:  <http://semweb.mmlab.be/ns/rml#>
PREFIX rmlc: <http://w3id.org/rml/>

TEMPLATE {
  "# Generated by rml2sparql-generate from an RML mapping\n"
  "# (https://github.com/sparql-generate/rml-to-sparql-generate).\n"
  TEMPLATE <templates/checks.rqg>(?dialect) .
  "BASE <" ?base ">\n"
  "PREFIX iter: <http://w3id.org/sparql-generate/iter/>\n"
  "\nGENERATE \{\n"

  TEMPLATE <templates/triplesMap.rqg>(?tm, ?rf, ?dialect, ?tmbase)
  WHERE {
    ?tm (rml:logicalSource|rmlc:logicalSource)/(rml:referenceFormulation|rmlc:referenceFormulation) ?rfi .
    BIND(REPLACE(STR(?rfi), "^.*[#/]", "") AS ?rf)
    FILTER(?rf IN ("CSV", "JSONPath", "XPath"))
    OPTIONAL { ?tm rmlc:baseIRI ?b }
    BIND(COALESCE(STR(?b), ?base) AS ?tmbase)
  } ORDER BY ?tm .

  TEMPLATE <templates/join.rqg>(?tm, ?pom, ?pt, ?pc, ?om, ?rf, ?prf, ?dialect, ?tmbase, ?pbase)
  WHERE {
    ?tm (rr:predicateObjectMap|rmlc:predicateObjectMap) ?pom .
    ?pom (rr:objectMap|rmlc:objectMap) ?om .
    ?om (rr:parentTriplesMap|rmlc:parentTriplesMap) ?ptm .
    ?tm (rml:logicalSource|rmlc:logicalSource) ?ls1 .
    ?ptm (rml:logicalSource|rmlc:logicalSource) ?ls2 .
    # with a join condition, or over another logical source
    FILTER(EXISTS { ?om (rr:joinCondition|rmlc:joinCondition) ?anon1 } || !(?ls1 = ?ls2 || EXISTS {
      ?ls1 (rml:source|rmlc:source) ?src ; (rml:referenceFormulation|rmlc:referenceFormulation) ?rfa .
      ?ls2 (rml:source|rmlc:source) ?src ; (rml:referenceFormulation|rmlc:referenceFormulation) ?rfa .
      FILTER NOT EXISTS { ?ls1 (rml:iterator|rmlc:iterator) ?i1 . FILTER NOT EXISTS { ?ls2 (rml:iterator|rmlc:iterator) ?i1 } }
      FILTER NOT EXISTS { ?ls2 (rml:iterator|rmlc:iterator) ?i2 . FILTER NOT EXISTS { ?ls1 (rml:iterator|rmlc:iterator) ?i2 } }
    }))
    { ?pom (rr:predicateMap|rmlc:predicateMap) ?pm0 } UNION { ?pom (rr:predicate|rmlc:predicate) ?pc0 }
    BIND(COALESCE(?pm0, <urn:x-rml2sg:none>) AS ?pt)
    BIND(COALESCE(?pc0, <urn:x-rml2sg:none>) AS ?pc)
    ?ls1 (rml:referenceFormulation|rmlc:referenceFormulation) ?rfi .
    ?ls2 (rml:referenceFormulation|rmlc:referenceFormulation) ?prfi .
    BIND(REPLACE(STR(?rfi), "^.*[#/]", "") AS ?rf)
    BIND(REPLACE(STR(?prfi), "^.*[#/]", "") AS ?prf)
    OPTIONAL { ?tm rmlc:baseIRI ?b }
    BIND(COALESCE(STR(?b), ?base) AS ?tmbase)
    OPTIONAL { ?ptm rmlc:baseIRI ?pb }
    BIND(COALESCE(STR(?pb), ?base) AS ?pbase)
    # the triples go to the default graph (see templates/triplesMap.rqg)
    FILTER(NOT EXISTS { { ?tm (rr:subjectMap|rmlc:subjectMap)/(rr:graphMap|rmlc:graphMap|rr:graph|rmlc:graph) ?g1 } UNION { ?pom (rr:graphMap|rmlc:graphMap|rr:graph|rmlc:graph) ?g2 } }
        || EXISTS { { ?tm (rr:subjectMap|rmlc:subjectMap)/((rr:graphMap|rmlc:graphMap)/(rr:constant|rmlc:constant)|rr:graph|rmlc:graph) ?dg }
                    UNION { ?pom ((rr:graphMap|rmlc:graphMap)/(rr:constant|rmlc:constant)|rr:graph|rmlc:graph) ?dg }
                    FILTER(?dg IN (rr:defaultGraph, rmlc:defaultGraph)) })
  } .

  "}\nWHERE \{}\n"
}
WHERE {
  # the base IRI is the one given on the command line (-b)
  BIND(STR(IRI("")) AS ?base)
  BIND(IF(EXISTS { ?x rmlc:logicalSource ?y }, "rmlc", "rml") AS ?dialect)
}
